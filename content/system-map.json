{
  "caption": "Two journeys through one system. On top, sensor readings flow through a broker into a stream, where functions write them to a time-series database while an archiver batches them into object storage. Below, an operator’s dashboard request passes a CDN, a gateway and API pods, and is answered from cache when it can. Click any underlined part to open it.",
  "w": 1040,
  "h": 440,
  "wide": true,
  "zones": [
    {"x":14,"y":8,"w":1012,"h":214,"label":"Ingest path · a sensor reading comes in"},
    {"x":14,"y":322,"w":1012,"h":110,"label":"Serve path · a dashboard request goes out"}
  ],
  "nodes": [
    {
      "id": "sensors",
      "x": 95,
      "y": 110,
      "label": "Field sensors",
      "sub": "10k devices",
      "emit": {"every":560,"jitter":0.5,"color":1},
      "out": ["broker"]
    },
    {
      "id": "broker",
      "x": 255,
      "y": 110,
      "label": "MQTT broker",
      "sub": "pub/sub",
      "concept": "pubsub",
      "out": ["stream"]
    },
    {
      "id": "stream",
      "x": 490,
      "y": 110,
      "kind": "log",
      "cells": 8,
      "label": "Event stream",
      "sub": "topic: readings",
      "concept": "stream",
      "retain": 40,
      "readers": [{"to":"fn","every":520,"name":"fn"},{"to":"obj","every":3600,"batch":5,"name":"archive"}]
    },
    {
      "id": "obj",
      "x": 760,
      "y": 58,
      "label": "Object storage",
      "sub": "raw/2026/09/26/",
      "concept": "object",
      "out": ["wh"]
    },
    {
      "id": "wh",
      "x": 935,
      "y": 58,
      "label": "Warehouse",
      "sub": "Iceberg · SQL",
      "concept": "warehouse",
      "mode": "sink"
    },
    {
      "id": "fn",
      "x": 760,
      "y": 165,
      "kind": "pool",
      "label": "Functions",
      "sub": "decode + write",
      "concept": "serverless",
      "max": 5,
      "work": 450,
      "idle": 2600,
      "cold": 300,
      "out": ["tsdb"]
    },
    {
      "id": "tsdb",
      "x": 935,
      "y": 272,
      "label": "Time-series DB",
      "sub": "readings",
      "concept": "tsdb",
      "mode": "reply",
      "delay": 160
    },
    {
      "id": "user",
      "x": 95,
      "y": 382,
      "label": "Operator",
      "sub": "browser",
      "emit": {"every":1500,"jitter":0.4,"req":true,"color":0},
      "out": ["cdn"]
    },
    {
      "id": "cdn",
      "x": 255,
      "y": 382,
      "label": "CDN edge",
      "sub": "cache",
      "concept": "cdn",
      "mode": "cache",
      "p": 0.4,
      "out": ["gw"]
    },
    {
      "id": "gw",
      "x": 420,
      "y": 382,
      "label": "API gateway",
      "sub": "auth · limits",
      "concept": "apigw",
      "mode": "gate",
      "p": 0.93,
      "denyText": "429",
      "out": ["api"]
    },
    {
      "id": "api",
      "x": 590,
      "y": 382,
      "kind": "pool",
      "label": "API pods",
      "sub": "Kubernetes",
      "concept": "orchestration",
      "min": 1,
      "max": 3,
      "work": 260,
      "idle": 4000,
      "out": ["cache"]
    },
    {
      "id": "cache",
      "x": 760,
      "y": 382,
      "label": "Cache",
      "sub": "Redis · 60 s",
      "concept": "cache",
      "mode": "cache",
      "p": 0.55,
      "out": ["tsdb"]
    }
  ]
