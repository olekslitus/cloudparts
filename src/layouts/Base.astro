---
import '@/styles/global.css';
import { MenuIcon, PanelLeftCloseIcon, PanelLeftOpenIcon, SearchIcon } from 'lucide-react';
import IconSprite from '@/components/IconSprite.astro';
import NavTree from '@/components/NavTree.astro';
import Outline from '@/components/Outline.astro';
import Search from '@/components/Search';
import TermCard from '@/components/TermCard.astro';
import ThemeToggle from '@/components/ThemeToggle';
import { getCatalog } from '@/lib/catalog';
import { logoOf } from '@/lib/glyphs';
import { href, navData, REPO_URL } from '@/lib/nav';
import { navTree, type Where } from '@/lib/navtree';

export type Section = 'home' | 'concepts' | 'topics' | 'kinds' | 'technologies' | 'architectures' | 'compare' | 'resources' | 'benchmarks' | 'playground';

interface Props {
  title?: string;
  description?: string;
  section: Section;
  /** Highlights this id in the sidebar: a concept, kind, technology, architecture or (on topic pages) category. */
  active?: string;
  /** Sections for the page outline at the right edge of wide screens. */
  outline?: { id: string; label: string }[];
}

const { title, description, active, section, outline } = Astro.props;
const full = section === 'playground';
const catalog = await getCatalog();
const nav = navData(catalog, logoOf);
const base = href();
const repo = REPO_URL;
const fullTitle = title ? `${title} · Cloud Parts` : 'Cloud Parts: Handbook for Modern Software Engineering';
const desc = description ?? 'Cloud Parts, a handbook for modern software engineering: how code, systems, delivery and teams work, with live models, plain-language explanations and sources for every fact.';
// the page being shown, so its item in the sidebar is highlighted and its branch starts open
const page = active
  ? ({ topics: 'topic', concepts: 'concept', kinds: 'kind', technologies: 'tech', compare: 'compare', architectures: 'architecture', benchmarks: 'benchmark' } as const)[section as string] as Where['page']
  : undefined;
const tree = navTree(catalog, { section, page, active });
const iconButton = 'inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <style is:global>
      /* On wide screens the sidebar can be hidden; the choice is set on <html> before first paint.
         On narrow screens it is a drawer, opened from the menu button. */
      @media (min-width: 64rem) {
        /* The sidebar is fixed to the window, so only the page scrolls; the page makes room for it. */
        [data-main] { padding-left: 280px; }
        html[data-sidebar='closed'] [data-main] { padding-left: 0; }
        html[data-sidebar='closed'] [data-sidebar-panel] { display: none !important; }
        html:not([data-sidebar='closed']) [data-sidebar-open] { display: none !important; }
      }
      @media (max-width: 63.99rem) {
        html[data-drawer] [data-sidebar-panel], html[data-drawer] [data-drawer-backdrop] { display: flex !important; }
        html[data-drawer] body { overflow: hidden; }
      }
      [data-nav][open] > summary [data-chev] { transform: rotate(90deg); }
      /* No rubber-band bounce: it dragged the sidebar along with the page. */
      html { overscroll-behavior-y: none; }
    </style>
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
        if (localStorage.getItem('sidebar') === 'closed') document.documentElement.dataset.sidebar = 'closed';
      } catch {}
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <IconSprite />
    <header class="sticky top-0 z-40 flex h-14 items-center gap-2 border-b bg-background/80 px-4 backdrop-blur supports-[backdrop-filter]:bg-background/70 lg:hidden">
      <button type="button" data-drawer-open class={iconButton} aria-label="Open navigation" aria-expanded="false"><MenuIcon className="size-4" /></button>
      <a href={base} class="flex items-center gap-2" aria-label="Cloud Parts, home">
        <svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true" class="shrink-0 text-foreground">
            <rect x="1" y="1" width="24" height="24" rx="6" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <path d="M6 17 L13 9 L20 17" fill="none" stroke="currentColor" stroke-width="1.6"></path>
            <circle cx="6" cy="17" r="2.4" fill="var(--p2)"></circle>
            <circle cx="13" cy="9" r="2.4" fill="var(--p1)"></circle>
            <circle cx="20" cy="17" r="2.4" fill="var(--p3)"></circle>
          </svg>
        <span class="font-semibold tracking-tight">Cloud Parts</span>
      </a>
      <span class="ml-auto flex items-center gap-1">
        <button type="button" data-open-search="" class={iconButton} aria-label="Search"><SearchIcon className="size-4" /></button>
        <ThemeToggle client:load />
      </span>
    </header>

    <button type="button" data-sidebar-open class:list={[iconButton, 'fixed top-3 left-3 z-40 hidden border bg-background shadow-sm lg:inline-flex']} aria-label="Show sidebar" title="Show sidebar">
      <PanelLeftOpenIcon className="size-4" />
    </button>

    <div class="flex">
      <div data-drawer-backdrop class="fixed inset-0 z-40 hidden bg-black/40 lg:hidden" aria-hidden="true"></div>
      <aside data-sidebar-panel class="fixed inset-y-0 left-0 z-50 hidden h-dvh w-[min(300px,85vw)] shrink-0 flex-col border-r bg-sidebar shadow-xl lg:z-30 lg:flex lg:w-[280px] lg:shadow-none" aria-label="Site navigation">
        <div class="flex items-center gap-2 px-3 pt-3 pb-2">
          <a href={base} class="flex min-w-0 items-center gap-2 rounded-md px-1.5 py-1 hover:bg-muted" aria-label="Cloud Parts, home">
            <svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true" class="shrink-0 text-foreground">
            <rect x="1" y="1" width="24" height="24" rx="6" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <path d="M6 17 L13 9 L20 17" fill="none" stroke="currentColor" stroke-width="1.6"></path>
            <circle cx="6" cy="17" r="2.4" fill="var(--p2)"></circle>
            <circle cx="13" cy="9" r="2.4" fill="var(--p1)"></circle>
            <circle cx="20" cy="17" r="2.4" fill="var(--p3)"></circle>
          </svg>
            <span class="truncate font-semibold tracking-tight">Cloud Parts</span>
          </a>
          <button type="button" data-sidebar-close class:list={[iconButton, 'ml-auto']} aria-label="Hide sidebar" title="Hide sidebar">
            <PanelLeftCloseIcon className="size-4" />
          </button>
        </div>
        <div class="px-3 pb-2"><Search client:idle nav={nav} base={base} /></div>
        <nav class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-2 pt-1 pb-6" aria-label="Site" data-sidebar-scroll>
          <NavTree nodes={tree} />
        </nav>
        <div class="flex items-center gap-1 border-t px-3 py-2">
          <ThemeToggle client:load />
          {repo && <a href={repo} class={iconButton} aria-label="Source on GitHub" title="Source on GitHub"><svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true"><path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" /></svg></a>}
          {repo && <a href={`${repo}/blob/main/CONTRIBUTING.md`} class="ml-auto text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Add a technology →</a>}
        </div>
      </aside>

      <div data-main class="flex min-w-0 flex-1 flex-col">
        {full ? (
          <main id="main" class="min-w-0 flex-1 px-4 pt-6 pb-12 sm:px-6"><slot /></main>
        ) : (
          <main id="main" class="min-w-0 flex-1 px-4 pt-8 pb-20 sm:px-8 lg:px-12 lg:pt-12">
            <div class="mx-auto max-w-5xl">
              <slot />
            </div>
          </main>
        )}
      </div>
    </div>

    {outline && <Outline items={outline} />}
    <TermCard />

    <script>
      // Hides or shows the sidebar on wide screens, remembered across pages.
      const setSidebar = (open: boolean) => {
        if (open) delete document.documentElement.dataset.sidebar; else document.documentElement.dataset.sidebar = 'closed';
        try { localStorage.setItem('sidebar', open ? 'open' : 'closed'); } catch {}
      };
      // On narrow screens the same button closes the drawer instead.
      document.querySelector('[data-sidebar-close]')?.addEventListener('click', () => {
        if (matchMedia('(min-width: 64rem)').matches) setSidebar(false); else drawer(false);
      });
      document.querySelector('[data-sidebar-open]')?.addEventListener('click', () => setSidebar(true));

      // Anything marked data-open-search opens the search dialog, with its value typed in.
      // The dialog loads when the browser is idle, so a very early click waits for it.
      const openSearch = (q: string) => {
        const send = () => document.dispatchEvent(new CustomEvent('open-search', { detail: q }));
        if (document.documentElement.dataset.search === 'ready') return send();
        let tries = 0;
        const wait = setInterval(() => {
          if (document.documentElement.dataset.search === 'ready' || ++tries > 40) {
            clearInterval(wait);
            send();
          }
        }, 50);
      };
      for (const b of document.querySelectorAll<HTMLElement>('[data-open-search]')) {
        b.addEventListener('click', () => openSearch(b.dataset.openSearch ?? ''));
      }

      // Opens and closes the sidebar drawer on narrow screens.
      const drawer = (open: boolean) => {
        if (open) document.documentElement.dataset.drawer = ''; else delete document.documentElement.dataset.drawer;
        document.querySelector('[data-drawer-open]')?.setAttribute('aria-expanded', String(open));
        if (open) document.querySelector<HTMLElement>('[data-sidebar-scroll] [aria-current="page"]')?.scrollIntoView({ block: 'center' });
      };
      document.querySelector('[data-drawer-open]')?.addEventListener('click', () => drawer(true));
      document.querySelector('[data-drawer-backdrop]')?.addEventListener('click', () => drawer(false));
      addEventListener('keydown', e => { if (e.key === 'Escape' && 'drawer' in document.documentElement.dataset) drawer(false); });

      // Remembers which items in the sidebar you opened or folded, from page to page. The branch
      // holding the current page always opens.
      const KEY = 'nav-folds';
      const boxes = [...document.querySelectorAll<HTMLDetailsElement>('aside details[data-nav]')];
      let folds: Record<string, boolean> = {};
      try { folds = JSON.parse(sessionStorage.getItem(KEY) ?? '{}'); } catch {}
      const here = document.querySelector('[data-sidebar-scroll] [aria-current="page"]');
      for (const d of boxes) {
        const key = d.dataset.nav!;
        if (key in folds && !d.contains(here) ) d.open = folds[key];
        d.addEventListener('toggle', () => {
          folds[key] = d.open;
          try { sessionStorage.setItem(KEY, JSON.stringify(folds)); } catch {}
        });
      }
      here?.scrollIntoView({ block: 'nearest' });

      // Opens a collapsed section (history, sources) when a link points into it.
      const reveal = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const el = id && document.getElementById(id);
        if (!el) return;
        const box = el.closest('details') ?? (el instanceof HTMLDetailsElement ? el : null);
        if (box && !box.open) { box.open = true; el.scrollIntoView(); }
      };
      reveal();
      addEventListener('hashchange', reveal);
    </script>
  </body>
</html>
