---
import '@/styles/global.css';
import { ChevronRightIcon } from 'lucide-react';
import HandbookNav from '@/components/HandbookNav.astro';
import MobileNav from '@/components/MobileNav';
import Search from '@/components/Search';
import ThemeToggle from '@/components/ThemeToggle';
import { getCatalog } from '@/lib/catalog';
import { href, navData } from '@/lib/nav';

export type Section = 'home' | 'concepts' | 'topics' | 'kinds' | 'technologies' | 'architectures' | 'compare' | 'resources' | 'benchmarks' | 'playground';

interface Props {
  title?: string;
  description?: string;
  section: Section;
  /** Highlights this id in the sidebar: a concept, kind, technology, architecture or (on topic pages) category. */
  active?: string;
}

const { title, description, active, section } = Astro.props;
const full = section === 'playground';
const sidebar = section === 'architectures' ? 'architectures' : 'handbook';
const catalog = await getCatalog();
const nav = navData(catalog);
const base = href();
const repo = import.meta.env.PUBLIC_REPO_URL as string | undefined;
const fullTitle = title ? `${title} · Cloud Parts` : 'Cloud Parts: Handbook for Modern Software Engineering';
const desc = description ?? 'Cloud Parts, a handbook for modern software engineering: how code, systems, delivery and teams work, with live models, plain-language explanations and sources for every fact.';
const topLinks = [
  { label: 'Handbook', path: 'concepts/', on: ['concepts', 'topics', 'kinds', 'technologies'].includes(section) },
  { label: 'Architectures', path: 'architectures/', on: section === 'architectures' },
  { label: 'Compare', path: 'compare/', on: section === 'compare' },
  { label: 'Playground', path: 'playground/', on: section === 'playground' },
];
// smaller sections, linked from the sidebar, mobile menu and footer instead of the top bar
const moreLinks = [
  { label: 'All technologies', path: 'technologies/', on: section === 'technologies' && !active },
  { label: 'Resources', path: 'resources/', on: section === 'resources' },
  { label: 'Benchmarks', path: 'benchmarks/', on: section === 'benchmarks' },
];
// where the current page sits, so its branch of the sidebar starts open
const page = !active ? undefined
  : ({ topics: 'topic', concepts: 'concept', kinds: 'kind', technologies: 'tech' } as const)[section as string];
const activeConcept = page === 'concept' ? active
  : page === 'kind' ? catalog.kind(active!).concept
  : page === 'tech' ? catalog.tech(active!).concepts[0]
  : undefined;
const activeCat = page === 'topic' ? active : activeConcept && catalog.concept(activeConcept).category;
const activePart = activeCat && catalog.category(activeCat).part;
const linkClass = (on: boolean) => [
  'flex items-baseline gap-2 rounded-md px-2 py-1 text-sm transition-colors hover:bg-muted',
  on ? 'bg-brand-soft font-medium text-foreground' : 'text-foreground/80',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/70">
      <div class="mx-auto flex h-14 max-w-screen-2xl items-center gap-2 px-4 lg:gap-6">
        <MobileNav client:idle nav={nav} base={base} active={active} page={page} activePart={activePart} activeConcept={activeConcept} section={sidebar} links={topLinks} more={moreLinks} />
        <a href={base} class="flex shrink-0 items-center gap-2.5" aria-label="Cloud Parts, home">
          <svg width="24" height="24" viewBox="0 0 26 26" aria-hidden="true" class="text-foreground">
            <rect x="1" y="1" width="24" height="24" rx="6" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <path d="M6 17 L13 9 L20 17" fill="none" stroke="currentColor" stroke-width="1.6"></path>
            <circle cx="6" cy="17" r="2.4" fill="var(--p2)"></circle>
            <circle cx="13" cy="9" r="2.4" fill="var(--p1)"></circle>
            <circle cx="20" cy="17" r="2.4" fill="var(--p3)"></circle>
          </svg>
          <span class="font-semibold tracking-tight whitespace-nowrap">Cloud Parts <span class="hidden font-normal text-muted-foreground xl:inline">Handbook for Modern Software Engineering</span></span>
        </a>
        <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Sections">
          {topLinks.map(l => (
            <a
              href={href(l.path)}
              aria-current={l.on ? 'page' : undefined}
              class:list={['rounded-md px-3 py-1.5 text-sm transition-colors hover:text-foreground', l.on ? 'font-medium text-foreground' : 'text-muted-foreground']}
            >{l.label}</a>
          ))}
        </nav>
        <div class="ml-auto flex min-w-0 items-center gap-1.5">
          <div class="min-w-0 flex-1"><Search client:idle nav={nav} base={base} /></div>
          <ThemeToggle client:load />
          {repo && (
            <a href={repo} class="hidden size-8 items-center justify-center rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground sm:inline-flex" aria-label="Source on GitHub">
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z" /></svg>
            </a>
          )}
        </div>
      </div>
    </header>

    {full ? (
      <main id="main" class="min-w-0 px-4 pt-6 pb-12 sm:px-6"><slot /></main>
    ) : (
      <div class="mx-auto grid max-w-screen-2xl lg:grid-cols-[300px_minmax(0,1fr)]">
        <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] overflow-y-auto border-r px-4 pt-5 pb-10 lg:block" aria-label={sidebar === 'handbook' ? 'Handbook' : 'Architectures'}>
          {sidebar === 'handbook' && <HandbookNav catalog={catalog} page={page} active={active} activePart={activePart} activeConcept={activeConcept} />}
          {sidebar === 'handbook' && (
            <div class="mt-6 border-t pt-4">
              <h3 class="mb-1 px-2 font-mono text-[11px] font-medium tracking-wider text-muted-foreground uppercase">More</h3>
              <ul>
                {[{ label: 'Comparisons', path: 'compare/', on: section === 'compare' }, ...moreLinks].map(l => (
                  <li><a href={href(l.path)} aria-current={l.on ? 'page' : undefined} class:list={linkClass(l.on)}>{l.label}</a></li>
                ))}
              </ul>
            </div>
          )}
          {sidebar === 'architectures' && (
            <div class="mb-5">
              <h3 class="mb-1 px-2 font-mono text-[11px] font-medium tracking-wider text-muted-foreground uppercase">Architectures</h3>
              <ul>
                {nav.architectures.map(a => (
                  <li>
                    <a href={href(`architectures/${a.id}/`)} aria-current={a.id === active ? 'page' : undefined} class:list={linkClass(a.id === active)}>{a.name}</a>
                  </li>
                ))}
              </ul>
              <a href={href('playground/')} class="mt-4 flex items-center gap-2 rounded-md border border-dashed px-2 py-2 text-sm text-muted-foreground transition hover:border-foreground/30 hover:text-foreground">Design your own in the playground →</a>
            </div>
          )}
        </aside>

        <main id="main" class="min-w-0 px-4 pt-8 pb-20 sm:px-8 lg:px-10">
          <div class="mx-auto max-w-5xl">
            <slot />
          </div>
        </main>
      </div>
    )}

    <script>
      // Keeps the parts and concepts you expanded in the sidebar open from page to page.
      const KEY = 'nav-open';
      const boxes = [...document.querySelectorAll<HTMLDetailsElement>('aside details[data-nav]')];
      if (boxes.length) {
        let open = new Set<string>();
        try { open = new Set(JSON.parse(sessionStorage.getItem(KEY) ?? '[]')); } catch {}
        for (const d of boxes) if (open.has(d.dataset.nav!)) d.open = true;
        for (const d of boxes) {
          d.addEventListener('toggle', () => {
            if (d.open) open.add(d.dataset.nav!); else open.delete(d.dataset.nav!);
            try { sessionStorage.setItem(KEY, JSON.stringify([...open])); } catch {}
          });
        }
        document.querySelector('aside [aria-current="page"]')?.scrollIntoView({ block: 'nearest' });
      }
    </script>

    <footer class="border-t">
      <div class="mx-auto flex max-w-screen-2xl flex-wrap items-center justify-between gap-2 px-4 py-6 text-sm text-muted-foreground">
        <span>{catalog.concepts.length} concepts · {catalog.technologies.length} technologies · {catalog.architectures.length} architectures · {catalog.comparisons.length} comparisons · {catalog.resources.length} resources · {catalog.benchmarks.length} benchmarks</span>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-1" aria-label="More">
          {moreLinks.map(l => <a href={href(l.path)} class="underline-offset-4 hover:text-foreground hover:underline">{l.label}</a>)}
          {repo && <a href={`${repo}/blob/main/CONTRIBUTING.md`} class="underline-offset-4 hover:text-foreground hover:underline">Add a technology →</a>}
        </nav>
      </div>
    </footer>
  </body>
</html>
