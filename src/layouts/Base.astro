---
import '@/styles/global.css';
import { PanelLeftCloseIcon, PanelLeftOpenIcon, SearchIcon } from 'lucide-react';
import HandbookNav from '@/components/HandbookNav.astro';
import MobileNav from '@/components/MobileNav';
import Outline from '@/components/Outline.astro';
import Search from '@/components/Search';
import ThemeToggle from '@/components/ThemeToggle';
import { getCatalog } from '@/lib/catalog';
import { SECTION_ICONS, type SectionIcon } from '@/lib/icons';
import { href, navData, REPO_URL } from '@/lib/nav';

export type Section = 'home' | 'concepts' | 'topics' | 'kinds' | 'technologies' | 'architectures' | 'compare' | 'resources' | 'benchmarks' | 'playground';

interface Props {
  title?: string;
  description?: string;
  section: Section;
  /** Highlights this id in the sidebar: a concept, kind, technology, architecture or (on topic pages) category. */
  active?: string;
  /** Sections for the page outline at the right edge of wide screens. */
  outline?: { id: string; label: string }[];
}

const { title, description, active, section, outline } = Astro.props;
const full = section === 'playground';
const sidebar = section === 'architectures' ? 'architectures' : 'handbook';
const catalog = await getCatalog();
const nav = navData(catalog);
const base = href();
const repo = REPO_URL;
const fullTitle = title ? `${title} · Cloud Parts` : 'Cloud Parts: Handbook for Modern Software Engineering';
const desc = description ?? 'Cloud Parts, a handbook for modern software engineering: how code, systems, delivery and teams work, with live models, plain-language explanations and sources for every fact.';
// every section of the site, at the top of the sidebar and in the phone menu
const sections: { label: string; path: string; icon: SectionIcon; on: boolean }[] = [
  { label: 'Home', path: '', icon: 'home', on: section === 'home' },
  { label: 'Concepts', path: 'concepts/', icon: 'concepts', on: ['concepts', 'topics', 'kinds'].includes(section) },
  { label: 'Technologies', path: 'technologies/', icon: 'technologies', on: section === 'technologies' },
  { label: 'Compare', path: 'compare/', icon: 'compare', on: section === 'compare' },
  { label: 'Architectures', path: 'architectures/', icon: 'architectures', on: section === 'architectures' },
  { label: 'Playground', path: 'playground/', icon: 'playground', on: section === 'playground' },
  { label: 'Resources', path: 'resources/', icon: 'resources', on: section === 'resources' },
  { label: 'Benchmarks', path: 'benchmarks/', icon: 'benchmarks', on: section === 'benchmarks' },
];
// where the current page sits, so its branch of the sidebar starts open
const page = !active ? undefined
  : ({ topics: 'topic', concepts: 'concept', kinds: 'kind', technologies: 'tech' } as const)[section as string];
const activeConcept = page === 'concept' ? active
  : page === 'kind' ? catalog.kind(active!).concept
  : page === 'tech' ? catalog.tech(active!).concepts[0]
  : undefined;
const activeCat = page === 'topic' ? active : activeConcept && catalog.concept(activeConcept).category;
const activePart = activeCat && catalog.category(activeCat).part;
const linkClass = (on: boolean) => [
  'flex items-center gap-2 rounded-md px-2 py-1 text-sm transition-colors hover:bg-muted',
  on ? 'bg-brand-soft font-medium text-foreground' : 'text-foreground/80',
];
const iconButton = 'inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <style is:global>
      /* The sidebar can be hidden on wide screens; the choice is set on <html> before first paint. */
      html[data-sidebar='closed'] [data-sidebar-panel] { display: none !important; }
      html:not([data-sidebar='closed']) [data-sidebar-open] { display: none !important; }
    </style>
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
        if (localStorage.getItem('sidebar') === 'closed') document.documentElement.dataset.sidebar = 'closed';
      } catch {}
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <header class="sticky top-0 z-40 flex h-14 items-center gap-2 border-b bg-background/80 px-4 backdrop-blur supports-[backdrop-filter]:bg-background/70 lg:hidden">
      <MobileNav client:idle nav={nav} base={base} active={active} page={page} activePart={activePart} activeConcept={activeConcept} section={sidebar} links={sections.map(({ label, path, icon, on }) => ({ label, path, icon, on }))} />
      <a href={base} class="flex items-center gap-2" aria-label="Cloud Parts, home">
        <svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true" class="shrink-0 text-foreground">
            <rect x="1" y="1" width="24" height="24" rx="6" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <path d="M6 17 L13 9 L20 17" fill="none" stroke="currentColor" stroke-width="1.6"></path>
            <circle cx="6" cy="17" r="2.4" fill="var(--p2)"></circle>
            <circle cx="13" cy="9" r="2.4" fill="var(--p1)"></circle>
            <circle cx="20" cy="17" r="2.4" fill="var(--p3)"></circle>
          </svg>
        <span class="font-semibold tracking-tight">Cloud Parts</span>
      </a>
      <span class="ml-auto flex items-center gap-1">
        <button type="button" data-open-search="" class={iconButton} aria-label="Search"><SearchIcon className="size-4" /></button>
        <ThemeToggle client:load />
      </span>
    </header>

    <button type="button" data-sidebar-open class:list={[iconButton, 'fixed top-3 left-3 z-40 hidden border bg-background shadow-sm lg:inline-flex']} aria-label="Show sidebar" title="Show sidebar">
      <PanelLeftOpenIcon className="size-4" />
    </button>

    <div class="flex">
      <aside data-sidebar-panel class="sticky top-0 hidden h-screen w-[280px] shrink-0 flex-col border-r bg-sidebar lg:flex" aria-label="Site navigation">
        <div class="flex items-center gap-2 px-3 pt-3 pb-2">
          <a href={base} class="flex min-w-0 items-center gap-2 rounded-md px-1.5 py-1 hover:bg-muted" aria-label="Cloud Parts, home">
            <svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true" class="shrink-0 text-foreground">
            <rect x="1" y="1" width="24" height="24" rx="6" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <path d="M6 17 L13 9 L20 17" fill="none" stroke="currentColor" stroke-width="1.6"></path>
            <circle cx="6" cy="17" r="2.4" fill="var(--p2)"></circle>
            <circle cx="13" cy="9" r="2.4" fill="var(--p1)"></circle>
            <circle cx="20" cy="17" r="2.4" fill="var(--p3)"></circle>
          </svg>
            <span class="truncate font-semibold tracking-tight">Cloud Parts</span>
          </a>
          <button type="button" data-sidebar-close class:list={[iconButton, 'ml-auto']} aria-label="Hide sidebar" title="Hide sidebar">
            <PanelLeftCloseIcon className="size-4" />
          </button>
        </div>
        <div class="px-3 pb-2"><Search client:idle nav={nav} base={base} /></div>
        <nav class="px-3" aria-label="Sections">
          <ul class="grid gap-px">
            {sections.map(l => {
              const Icon = SECTION_ICONS[l.icon];
              return (
                <li>
                  <a href={href(l.path)} aria-current={l.on ? 'page' : undefined} class:list={linkClass(l.on)}>
                    <Icon className="size-4 shrink-0 text-muted-foreground" />{l.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        <div class="mt-3 min-h-0 flex-1 overflow-y-auto border-t px-3 pt-3 pb-6" data-sidebar-scroll>
          {sidebar === 'handbook' && <HandbookNav catalog={catalog} page={page} active={active} activePart={activePart} activeConcept={activeConcept} />}
          {sidebar === 'architectures' && (
            <div>
              <h3 class="mb-1 px-2 font-mono text-[11px] font-medium tracking-wider text-muted-foreground uppercase">Architectures</h3>
              <ul>
                {nav.architectures.map(a => (
                  <li>
                    <a href={href(`architectures/${a.id}/`)} aria-current={a.id === active ? 'page' : undefined} class:list={linkClass(a.id === active)}>{a.name}</a>
                  </li>
                ))}
              </ul>
              <a href={href('playground/')} class="mt-4 flex items-center gap-2 rounded-md border border-dashed px-2 py-2 text-sm text-muted-foreground transition hover:border-foreground/30 hover:text-foreground">Design your own in the playground →</a>
            </div>
          )}
        </div>
        <div class="flex items-center gap-1 border-t px-3 py-2">
          <ThemeToggle client:load />
          {repo && <a href={repo} class={iconButton} aria-label="Source on GitHub" title="Source on GitHub"><svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z" /></svg></a>}
          {repo && <a href={`${repo}/blob/main/CONTRIBUTING.md`} class="ml-auto text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Add a technology →</a>}
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        {full ? (
          <main id="main" class="min-w-0 flex-1 px-4 pt-6 pb-12 sm:px-6"><slot /></main>
        ) : (
          <main id="main" class="min-w-0 flex-1 px-4 pt-8 pb-20 sm:px-8 lg:px-12 lg:pt-12">
            <div class="mx-auto max-w-5xl">
              <slot />
            </div>
          </main>
        )}
        <footer class="border-t px-4 py-6 text-sm text-muted-foreground sm:px-8 lg:px-12">
          {catalog.concepts.length} concepts · {catalog.technologies.length} technologies · {catalog.architectures.length} architectures · {catalog.comparisons.length} comparisons · {catalog.resources.length} resources · {catalog.benchmarks.length} benchmarks
        </footer>
      </div>
    </div>

    {outline && <Outline items={outline} />}

    <script>
      // Hides or shows the sidebar on wide screens, remembered across pages.
      const setSidebar = (open: boolean) => {
        if (open) delete document.documentElement.dataset.sidebar; else document.documentElement.dataset.sidebar = 'closed';
        try { localStorage.setItem('sidebar', open ? 'open' : 'closed'); } catch {}
      };
      document.querySelector('[data-sidebar-close]')?.addEventListener('click', () => setSidebar(false));
      document.querySelector('[data-sidebar-open]')?.addEventListener('click', () => setSidebar(true));

      // Anything marked data-open-search opens the search dialog, with its value typed in.
      // The dialog loads when the browser is idle, so a very early click waits for it.
      const openSearch = (q: string) => {
        const send = () => document.dispatchEvent(new CustomEvent('open-search', { detail: q }));
        if (document.documentElement.dataset.search === 'ready') return send();
        let tries = 0;
        const wait = setInterval(() => {
          if (document.documentElement.dataset.search === 'ready' || ++tries > 40) {
            clearInterval(wait);
            send();
          }
        }, 50);
      };
      for (const b of document.querySelectorAll<HTMLElement>('[data-open-search]')) {
        b.addEventListener('click', () => openSearch(b.dataset.openSearch ?? ''));
      }

      // Keeps the parts and concepts you expanded in the sidebar open from page to page.
      const KEY = 'nav-open';
      const boxes = [...document.querySelectorAll<HTMLDetailsElement>('aside details[data-nav]')];
      if (boxes.length) {
        let open = new Set<string>();
        try { open = new Set(JSON.parse(sessionStorage.getItem(KEY) ?? '[]')); } catch {}
        for (const d of boxes) if (open.has(d.dataset.nav!)) d.open = true;
        for (const d of boxes) {
          d.addEventListener('toggle', () => {
            if (d.open) open.add(d.dataset.nav!); else open.delete(d.dataset.nav!);
            try { sessionStorage.setItem(KEY, JSON.stringify([...open])); } catch {}
          });
        }
        document.querySelector('[data-sidebar-scroll] [aria-current="page"]')?.scrollIntoView({ block: 'nearest' });
      }

      // Opens a collapsed section (history, sources) when a link points into it.
      const reveal = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const el = id && document.getElementById(id);
        if (!el) return;
        const box = el.closest('details') ?? (el instanceof HTMLDetailsElement ? el : null);
        if (box && !box.open) { box.open = true; el.scrollIntoView(); }
      };
      reveal();
      addEventListener('hashchange', reveal);
    </script>
  </body>
</html>
