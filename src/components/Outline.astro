---
// The page outline, Notion-style: a column of short dashes at the right edge of wide screens.
// Hover or tab into it to see the section names; the dash of the section you're reading is darker.
interface Props { items: { id: string; label: string }[] }
const { items } = Astro.props;
---

{items.length > 2 && (
  <nav aria-label="On this page" class="group/outline fixed top-1/2 right-3 z-30 hidden -translate-y-1/2 xl:block">
    <ul class="flex flex-col items-end gap-2.5 px-1 py-2" aria-hidden="true">
      {items.map(i => <li><span data-dash={i.id} class="block h-[2px] w-3.5 rounded-full bg-foreground/20 transition-all"></span></li>)}
    </ul>
    <ul class="pointer-events-none absolute top-1/2 right-0 max-h-[75vh] w-64 -translate-y-1/2 overflow-y-auto rounded-xl border bg-popover p-1.5 text-popover-foreground opacity-0 shadow-lg transition-opacity group-focus-within/outline:pointer-events-auto group-focus-within/outline:opacity-100 group-hover/outline:pointer-events-auto group-hover/outline:opacity-100">
      {items.map(i => (
        <li><a href={`#${i.id}`} data-outline={i.id} class="block rounded-md px-2.5 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">{i.label}</a></li>
      ))}
    </ul>
  </nav>
)}

<script>
  // Marks the section you're reading: the last one whose top has scrolled past the header.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-outline]')];
  if (links.length) {
    const targets = links.map(a => document.getElementById(a.dataset.outline!)).filter((x): x is HTMLElement => !!x);
    const mark = () => {
      let current = targets[0]?.id;
      for (const t of targets) if (t.getBoundingClientRect().top < 120) current = t.id;
      for (const a of links) {
        const on = a.dataset.outline === current;
        a.classList.toggle('text-foreground', on);
        a.classList.toggle('font-medium', on);
        if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
      }
      for (const d of document.querySelectorAll<HTMLElement>('[data-dash]')) {
        const on = d.dataset.dash === current;
        d.classList.toggle('bg-foreground/70', on);
        d.classList.toggle('w-5', on);
        d.classList.toggle('bg-foreground/20', !on);
      }
    };
    mark();
    addEventListener('scroll', mark, { passive: true });
  }
</script>
