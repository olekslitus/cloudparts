---
// One technology as a full-width row: name, badge and type on top, its summary underneath.
import StatusBadge from '@/components/StatusBadge.astro';
import type { CatalogTech } from '@/lib/catalog';
import { href, PROVIDER_NAMES } from '@/lib/nav';

interface Props {
  tech: CatalogTech;
  /** Shown as "Mainly <also>" when the row appears under a secondary concept. */
  also?: string;
  /** A short phrase shown above the summary, e.g. a "worksWith" relationship. */
  note?: string;
  /** Technologies listed under this one, named at the bottom of the row. */
  family?: CatalogTech[];
}
const { tech: t, also, note, family = [] } = Astro.props;
---

<a href={href(`technologies/${t.id}/`)} class="group flex flex-col rounded-xl bg-card px-4 py-3 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
  <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <span class="font-medium group-hover:text-brand">{t.name}</span>
    <StatusBadge tech={t} />
    <span class="ml-auto shrink-0 font-mono text-[10px] tracking-wide text-muted-foreground uppercase">{PROVIDER_NAMES[t.provider]}</span>
  </span>
  {note && <span class="mt-1 text-xs font-medium text-brand">{note}</span>}
  <span class="mt-1 text-sm leading-snug text-muted-foreground">{t.summary}</span>
  {family.length > 0 && (
    <span class="mt-2 text-xs text-muted-foreground"><span class="font-medium text-foreground/80">+{family.length}</span> {family.slice(0, 4).map(x => x.name).join(', ')}{family.length > 4 && '…'}</span>
  )}
  {also && <span class="mt-2 font-mono text-[10px] tracking-wide text-muted-foreground uppercase">Mainly {also}</span>}
</a>
