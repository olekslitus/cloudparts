---
import type { CatalogTech } from '@/lib/catalog';
import { href, PROVIDER_NAMES } from '@/lib/nav';

interface Props {
  tech: CatalogTech;
  /** Shown as "Mainly <also>" when the card appears under a secondary concept. */
  also?: string;
  /** A short phrase shown above the summary, e.g. a "worksWith" relationship. */
  note?: string;
  /** Technologies listed under this one, named at the bottom of the card. */
  family?: CatalogTech[];
}
const { tech: t, also, note, family = [] } = Astro.props;
---

<a href={href(`technologies/${t.id}/`)} class="group flex flex-col rounded-xl bg-card p-4 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
  <span class="flex items-baseline justify-between gap-2">
    <span class="font-medium group-hover:text-brand">{t.name}</span>
    {t.archived
      ? <span class="shrink-0 font-mono text-[10px] tracking-wide text-(--warn) uppercase">Archived</span>
      : <span class="shrink-0 font-mono text-[10px] tracking-wide text-muted-foreground uppercase">{PROVIDER_NAMES[t.provider]}</span>}
  </span>
  {note && <span class="mt-1 text-xs font-medium text-brand">{note}</span>}
  <span class="mt-1 line-clamp-2 text-sm leading-snug text-muted-foreground">{t.summary}</span>
  {family.length > 0 && (
    <span class="mt-2 truncate text-xs text-muted-foreground"><span class="font-medium text-foreground/80">+{family.length}</span> {family.slice(0, 3).map(x => x.name).join(', ')}{family.length > 3 && '…'}</span>
  )}
  {also && <span class="mt-2 font-mono text-[10px] tracking-wide text-muted-foreground uppercase">Mainly {also}</span>}
</a>
