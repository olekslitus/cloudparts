---
import { Code } from 'astro:components';
import LiveModel from '@/components/LiveModel';
import Md from '@/components/Md.astro';
import type { Catalog } from '@/lib/catalog';
import type { TechSection } from '@/content/schema';
import { diagramLinks } from '@/lib/links';

interface Props { section: TechSection; anchor: string; catalog: Catalog }
const { section: s, anchor, catalog } = Astro.props;
---

<section id={anchor} class="mt-14 scroll-mt-20">
  <h2 class="text-2xl font-semibold tracking-tight">
    <a href={`#${anchor}`} class="group">{s.title}<span class="ml-2 text-muted-foreground opacity-0 transition group-hover:opacity-100">#</span></a>
  </h2>
  {'intro' in s && s.intro && <p class="mt-2 max-w-3xl leading-relaxed text-muted-foreground"><Md text={s.intro} /></p>}

  {s.type === 'text' && (
    <div class="mt-4 max-w-3xl space-y-4 text-[17px] leading-relaxed">
      {s.body.map(para => <p><Md text={para} /></p>)}
    </div>
  )}

  {s.type === 'table' && (
    <div class="mt-5">
      <div class="overflow-x-auto rounded-xl bg-card ring-1 ring-foreground/10">
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b bg-muted/50">
              <th scope="col" class="sticky left-0 z-10 min-w-40 bg-muted px-4 py-3 align-bottom font-mono text-[11px] font-medium tracking-wide text-muted-foreground uppercase">{s.corner}</th>
              {s.columns.map(col => <th scope="col" class="min-w-28 px-4 py-3 align-bottom font-mono text-[11px] font-medium tracking-wide text-muted-foreground uppercase">{col}</th>)}
            </tr>
          </thead>
          <tbody>
            {s.rows.map(r => (
              <tr class="border-b last:border-b-0">
                <th scope="row" class="sticky left-0 z-10 bg-card px-4 py-3 align-top font-semibold">{r.label}</th>
                {r.values.map(v => <td class="px-4 py-3 align-top leading-snug"><Md text={v} /></td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {s.notes && (
        <ul class="mt-3 space-y-1 text-sm text-muted-foreground">
          {s.notes.map(n => <li><Md text={n} /></li>)}
        </ul>
      )}
    </div>
  )}

  {s.type === 'cards' && (
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {s.items.map(item => (
        <div class="rounded-xl bg-card p-4 ring-1 ring-foreground/10">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="font-semibold">{item.name}</h3>
            {item.tag && <span class="rounded-full bg-brand-soft px-2 py-0.5 font-mono text-[10px] font-medium tracking-wide text-brand uppercase">{item.tag}</span>}
          </div>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground"><Md text={item.text} /></p>
        </div>
      ))}
    </div>
  )}

  {s.type === 'model' && (
    <div class="mt-5">
      <LiveModel client:visible diagram={s.diagram} links={diagramLinks(catalog, s.diagram)} />
    </div>
  )}

  {s.type === 'code' && (
    <div class="mt-5" data-codebox>
      <div class="mb-2 flex items-center justify-between gap-2">
        <span class="font-mono text-[11px] tracking-widest text-muted-foreground uppercase">{s.lang}</span>
        <button type="button" data-copy class="inline-flex h-7 items-center rounded-md border bg-background px-2.5 text-xs font-medium transition hover:bg-muted">Copy</button>
      </div>
      <div class="overflow-hidden rounded-xl bg-muted/50 ring-1 ring-foreground/10 [&_pre]:overflow-x-auto [&_pre]:p-4 [&_pre]:font-mono [&_pre]:text-[13px] [&_pre]:leading-relaxed">
        <Code code={s.source} lang={s.lang} themes={{ light: 'github-light', dark: 'github-dark' }} />
      </div>
    </div>
  )}
</section>
