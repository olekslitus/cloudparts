---
// Renders a content string, turning `backticks` into inline code and marking the first mention of each
// technology or concept on the page with a dotted underline; hovering one shows a short explanation
// (see TermCard.astro). Nothing else is parsed.
import { getCatalog } from '@/lib/catalog';
import { findTerms, type Piece } from '@/lib/terms';

interface Props {
  text: string;
  /** Leave names unmarked, e.g. in a license. */
  plain?: boolean;
}
const { text, plain } = Astro.props;
const locals = Astro.locals as { terms?: Set<string> };
const seen = (locals.terms ??= new Set());
const catalog = plain ? undefined : await getCatalog();
const pieces = text.split(/`([^`]+)`/).map((s, i): Piece[] | { code: string } =>
  i % 2 ? { code: s } : catalog ? findTerms(catalog, s, seen, Astro.url.pathname) : [s]);
---
<span class="md">{pieces.map(p => ('code' in p ? <code>{p.code}</code> : p.map(x => (typeof x === 'string' ? x : (
  <a href={x.term.href} class="term" data-term-name={x.term.name} data-term-kind={x.term.kind} data-term-tip={x.term.summary}>{x.text}</a>
)))))}</span>
