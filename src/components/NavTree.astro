---
// One level of the sidebar tree. Every item looks the same: a chevron when it has children, a logo
// or icon, and its name. Items with children are <details>, so they fold without JavaScript; the
// chevron is the toggle and the name is a link. Base.astro remembers what was folded.
import { ChevronRightIcon } from 'lucide-react';
import Glyph from '@/components/Glyph.astro';
import type { NavNode } from '@/lib/navtree';

interface Props {
  nodes: NavNode[];
  depth?: number;
}
const { nodes, depth = 0 } = Astro.props;
const pad = `padding-left: ${depth * 14 + 4}px`;
const row = (n: NavNode) => [
  'flex h-8 items-center gap-1 rounded-md pr-2 text-sm transition-colors hover:bg-muted lg:h-7',
  n.current ? 'bg-brand-soft font-medium text-foreground' : 'text-foreground/85',
];
---

<ul>
  {nodes.map(n => {
    const link = (
      <a href={n.href} aria-current={n.current ? 'page' : undefined} class="flex h-full min-w-0 flex-1 items-center gap-2">
        <Glyph tech={n.tech} icon={n.icon} />
        <span class:list={['truncate', n.muted && 'text-muted-foreground']}>{n.label}</span>
        {n.tag && <span class:list={['ml-auto shrink-0 text-[11px]', n.tag.warn ? 'text-(--warn)' : 'text-brand']}>{n.tag.text}</span>}
      </a>
    );
    return (
      <li>
        {n.children.length ? (
          <details data-nav={n.key} open={n.open || undefined}>
            <summary class:list={[row(n), 'cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden']} style={pad}>
              <span class="flex size-4 shrink-0 items-center justify-center text-muted-foreground" aria-hidden="true">
                <ChevronRightIcon className="size-3.5 transition-transform" data-chev />
              </span>
              {link}
            </summary>
            <Astro.self nodes={n.children} depth={depth + 1} />
          </details>
        ) : (
          <div class:list={row(n)} style={pad}>
            <span class="size-4 shrink-0" aria-hidden="true"></span>
            {link}
          </div>
        )}
      </li>
    );
  })}
</ul>
