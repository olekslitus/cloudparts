---
// The card that explains an underlined term (see Md.astro): its kind, name and one-line summary, and
// a button that opens its page in a new tab. One card per page, filled in for whichever term is hovered
// or focused. On touch screens the first tap shows the card and a second tap follows the link.
import { ExternalLinkIcon } from 'lucide-react';
---

<div data-term-card role="tooltip" hidden class="fixed z-50 w-[min(320px,calc(100vw-24px))] rounded-xl bg-popover p-3.5 text-popover-foreground shadow-lg ring-1 ring-foreground/10">
  <div class="flex items-start gap-3">
    <div class="min-w-0 flex-1">
      <p data-kind class="text-[11px] tracking-wide text-muted-foreground uppercase"></p>
      <p data-name class="mt-0.5 font-medium leading-snug"></p>
    </div>
    <a data-open target="_blank" rel="noopener" class="inline-flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground" aria-label="Open in a new tab" title="Open in a new tab">
      <ExternalLinkIcon className="size-4" />
    </a>
  </div>
  <p data-tip class="mt-1.5 text-sm leading-snug text-muted-foreground"></p>
</div>

<script>
  const card = document.querySelector<HTMLElement>('[data-term-card]')!;
  const open = card.querySelector<HTMLAnchorElement>('[data-open]')!;
  let current: HTMLAnchorElement | null = null;
  let hideTimer = 0;

  const place = (term: HTMLElement) => {
    // under the word's first line, or above it when there's no room below
    const r = term.getClientRects()[0] ?? term.getBoundingClientRect();
    const w = card.offsetWidth, h = card.offsetHeight;
    const left = Math.min(Math.max(12, r.left), innerWidth - w - 12);
    const top = r.bottom + 8 + h > innerHeight && r.top - 8 - h > 0 ? r.top - 8 - h : r.bottom + 8;
    card.style.left = `${left}px`;
    card.style.top = `${top}px`;
  };
  const show = (term: HTMLAnchorElement) => {
    clearTimeout(hideTimer);
    current = term;
    card.querySelector('[data-kind]')!.textContent = term.dataset.termKind ?? '';
    card.querySelector('[data-name]')!.textContent = term.dataset.termName ?? '';
    card.querySelector('[data-tip]')!.textContent = term.dataset.termTip ?? '';
    open.href = term.href;
    card.hidden = false;
    place(term);
  };
  const hide = (now = false) => {
    clearTimeout(hideTimer);
    const go = () => { card.hidden = true; current = null; };
    if (now) go(); else hideTimer = window.setTimeout(go, 150);
  };

  for (const term of document.querySelectorAll<HTMLAnchorElement>('a.term')) {
    term.addEventListener('mouseenter', () => show(term));
    term.addEventListener('mouseleave', () => hide());
    term.addEventListener('focus', () => show(term));
    term.addEventListener('blur', e => { if (!card.contains(e.relatedTarget as Node)) hide(); });
    // touch: the first tap explains, the second follows the link
    term.addEventListener('click', e => {
      if (matchMedia('(hover: none)').matches && current !== term) { e.preventDefault(); show(term); }
    });
  }
  card.addEventListener('mouseenter', () => clearTimeout(hideTimer));
  card.addEventListener('mouseleave', () => hide());
  open.addEventListener('blur', () => hide());
  addEventListener('keydown', e => { if (e.key === 'Escape') hide(true); });
  addEventListener('scroll', () => hide(true), { passive: true });
  document.addEventListener('click', e => {
    if (!card.hidden && !card.contains(e.target as Node) && !(e.target as Element).closest?.('a.term')) hide(true);
  });
</script>
