---
// A concept's technologies, as grouped rows or as one sortable table to compare them side by side.
import Glyph from '@/components/Glyph.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import SortableTable from '@/components/SortableTable.astro';
import TechCard from '@/components/TechCard.astro';
import type { Catalog, CatalogTech } from '@/lib/catalog';
import { href, PROVIDER_TYPES, stageOf } from '@/lib/nav';

interface Props {
  catalog: Catalog;
  /** The concept the page is about; technologies mainly about another concept say so. */
  concept: string;
  groups: { name?: string; summary?: string; path?: string; techs: CatalogTech[] }[];
}
const { catalog: c, concept, groups } = Astro.props;
const all = groups.flatMap(g => g.techs.map(t => ({ t, group: g.name })));
const named = groups.some(g => g.name);
const also = (t: CatalogTech) => (t.concepts[0] !== concept ? c.concept(t.concepts[0]).name : undefined);
const th = 'px-3 py-2.5 text-left align-bottom font-mono text-[11px] font-medium tracking-wide text-muted-foreground uppercase';
const sortBtn = 'inline-flex items-center gap-1 uppercase hover:text-foreground';
const columns = ['Technology', ...(named ? ['Group'] : []), 'Type', 'Made by', 'License', 'Checked'];
---

<div data-listing>
  {all.length > 3 && (
    <div class="mb-4 inline-flex rounded-lg border p-0.5 text-sm" role="group" aria-label="View">
      <button type="button" data-view="list" aria-pressed="true" class="rounded-md px-3 py-1 aria-pressed:bg-muted aria-pressed:font-medium">List</button>
      <button type="button" data-view="table" aria-pressed="false" class="rounded-md px-3 py-1 aria-pressed:bg-muted aria-pressed:font-medium">Compare in a table</button>
    </div>
  )}

  <div data-pane="list" class="grid gap-8">
    {groups.map(g => (
      <div>
        {g.name && (
          <div class="mb-3">
            <h3 class="font-semibold">{g.path ? <a href={href(g.path)} class="underline-offset-4 hover:text-brand hover:underline">{g.name} →</a> : g.name}</h3>
            {g.summary && <p class="mt-0.5 text-sm text-muted-foreground">{g.summary}</p>}
          </div>
        )}
        <div class="grid gap-2">
          {g.techs.map(t => <TechCard tech={t} family={c.childrenOf(t.id)} also={also(t)} />)}
        </div>
      </div>
    ))}
  </div>

  <div data-pane="table" hidden class="overflow-x-auto rounded-xl bg-card ring-1 ring-foreground/10">
    <table class="w-full border-collapse text-sm" data-sortable>
      <thead>
        <tr class="border-b bg-muted/50">
          {columns.map((col, i) => (
            <th scope="col" class={th} aria-sort="none">
              <button type="button" class={sortBtn} data-sort={i}>{col}<span aria-hidden="true" data-arrow></span></button>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {all.map(({ t, group }) => {
          const stage = stageOf(t);
          return (
            <tr class="border-b align-top last:border-b-0">
              <td class="min-w-36 px-3 py-2.5" data-v={t.name.toLowerCase()} title={t.summary}>
                <a href={href(`technologies/${t.id}/`)} class="inline-flex items-center gap-2 font-medium underline-offset-4 hover:text-brand hover:underline"><Glyph tech={t} />{t.name}</a>
                {stage && <span class="ml-1.5 align-middle"><StatusBadge tech={t} /></span>}
              </td>
              {named && <td class="min-w-32 px-3 py-2.5 text-muted-foreground" data-v={group ?? ''}>{group ?? 'Other'}</td>}
              <td class="min-w-28 px-3 py-2.5" data-v={PROVIDER_TYPES[t.provider]}>{PROVIDER_TYPES[t.provider]}</td>
              <td class="min-w-28 px-3 py-2.5" data-v={t.vendor ?? ''}>{t.vendor ?? '–'}</td>
              <td class="min-w-36 px-3 py-2.5" data-v={t.license ?? ''}><span class="line-clamp-3" title={t.license}>{t.license ?? '–'}</span></td>
              <td class="px-3 py-2.5 font-mono text-xs whitespace-nowrap text-muted-foreground" data-v={t.checked}>{t.checked}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

<script>
  // List or table view, remembered across pages.
  const KEY = 'tech-view';
  for (const box of document.querySelectorAll<HTMLElement>('[data-listing]')) {
    const buttons = [...box.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const show = (view: string) => {
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.view === view));
      for (const pane of box.querySelectorAll<HTMLElement>('[data-pane]')) pane.hidden = pane.dataset.pane !== view;
    };
    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    if (saved === 'table' && buttons.length) show('table');
    for (const b of buttons) {
      b.addEventListener('click', () => {
        show(b.dataset.view!);
        try { localStorage.setItem(KEY, b.dataset.view!); } catch {}
      });
    }
  }
</script>

<SortableTable />
