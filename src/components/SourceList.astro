---
// A list of sources. A source with an archived copy links to the copy, with the original alongside.
import { ArchiveIcon, ExternalLinkIcon } from 'lucide-react';

interface Props {
  sources: { label: string; url: string; archive?: string }[];
  class?: string;
}

const { sources, class: className } = Astro.props;
const link = 'inline-flex items-center gap-1.5 text-muted-foreground underline-offset-4 hover:text-foreground hover:underline';
---

<ul class:list={['space-y-1.5', className]}>
  {sources.map(s => (
    <li>
      {s.archive ? (
        <>
          <a href={s.archive} rel="noopener" class={link}>{s.label}<ArchiveIcon className="size-3 shrink-0" /></a>
          <span class="text-xs text-muted-foreground"> · archived copy, <a href={s.url} rel="noopener" class="underline-offset-4 hover:text-foreground hover:underline">original</a></span>
        </>
      ) : (
        <a href={s.url} rel="noopener" class={link}>{s.label}<ExternalLinkIcon className="size-3 shrink-0" /></a>
      )}
    </li>
  ))}
</ul>
