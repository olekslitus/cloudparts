---
// The small picture in front of a name: a technology's logo, or else the Lucide icon of its concept
// (or of the concept or topic itself), drawn from the page's icon sprite (IconSprite.astro).
// Decorative, so screen readers skip it.
import type { CatalogTech } from '@/lib/catalog';
import { getCatalog } from '@/lib/catalog';
import { logoOf } from '@/lib/glyphs';

interface Props {
  tech?: CatalogTech;
  /** A Lucide icon name, used when there is no technology logo. */
  icon?: string;
  class?: string;
}
const { tech, icon, class: size = 'size-4' } = Astro.props;
const logo = tech && logoOf(tech.id);
const name = icon ?? (tech && (await getCatalog()).concept(tech.concepts[0]).icon);
---

{logo ? (
  <img src={logo.src} alt="" loading="lazy" decoding="async" class:list={[size, 'shrink-0 object-contain', logo.tone && `logo-${logo.tone}`]} />
) : name && (
  <svg class:list={[size, 'shrink-0 text-muted-foreground']} aria-hidden="true"><use href={`#i-${name}`} /></svg>
)}
