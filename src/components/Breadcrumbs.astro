---
// Where this page sits in the handbook: part / topic / concept. The last item may be a code chip.
import { ChevronRightIcon } from 'lucide-react';
import { href } from '@/lib/nav';

interface Props {
  items: { label: string; path?: string }[];
  /** A concept code like "DAT-02", shown last in brand color. */
  code?: string;
}
const { items, code } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-3">
  <ol class="flex flex-wrap items-center gap-1.5 font-mono text-xs tracking-wider text-muted-foreground uppercase">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <ChevronRightIcon className="size-3 opacity-60" aria-hidden="true" />}
        {item.path ? <a href={href(item.path)} class="hover:text-foreground">{item.label}</a> : <span>{item.label}</span>}
      </li>
    ))}
    {code && (
      <li class="flex items-center gap-1.5">
        <ChevronRightIcon className="size-3 opacity-60" aria-hidden="true" />
        <span class="font-semibold text-brand" aria-current="page">{code}</span>
      </li>
    )}
  </ol>
</nav>
