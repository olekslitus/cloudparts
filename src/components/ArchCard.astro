---
import { ArrowRightIcon } from 'lucide-react';
import type { Catalog, CatalogArch } from '@/lib/catalog';
import { href } from '@/lib/nav';

interface Props { arch: CatalogArch; catalog: Catalog; highlight?: string }
const { arch: a, catalog: c, highlight } = Astro.props;
---

<a href={href(`architectures/${a.id}/`)} class="group flex flex-col rounded-xl bg-card p-4 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
  <span class="flex items-center justify-between gap-3">
    <span class="font-semibold group-hover:text-brand">{a.title}</span>
    <ArrowRightIcon className="size-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-foreground" />
  </span>
  <span class="mt-1 text-sm leading-snug text-muted-foreground">{a.summary}</span>
  <span class="mt-3 flex flex-wrap gap-1.5">
    {a.techs.map(id => (
      <span class:list={['rounded-md px-2 py-0.5 text-xs', id === highlight ? 'bg-brand-soft font-medium text-brand' : 'bg-muted']}>{c.tech(id).name}</span>
    ))}
  </span>
</a>
