---
// "Where it came from": the story, the design choices and why, and a timeline.
import type { z } from 'astro/zod';
import Md from '@/components/Md.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import SourceList from '@/components/SourceList.astro';
import type { history } from '@/content/schema';

interface Props {
  history: z.output<typeof history>;
}

const { history: h } = Astro.props;
---

<section class="mt-12" id="history">
  <SectionLabel>Where it came from</SectionLabel>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
    <div>
      <div class="space-y-4 text-[17px] leading-relaxed">
        {h.story.map(p => <p><Md text={p} /></p>)}
      </div>
      <h3 class="mt-8 mb-3 text-sm font-semibold">Why it’s built this way</h3>
      <dl class="grid gap-3">
        {h.choices.map(c => (
          <div class="rounded-xl bg-card px-4 py-3 ring-1 ring-foreground/10">
            <dt class="font-medium leading-snug"><Md text={c.choice} /></dt>
            <dd class="mt-1 text-[15px] leading-relaxed text-muted-foreground"><Md text={c.why} /></dd>
          </div>
        ))}
      </dl>
    </div>
    <div>
      <ol class="relative ml-[3px] border-l pl-0">
        {h.timeline.map(e => (
          <li class="relative pb-5 pl-6 last:pb-0">
            <span class="absolute top-[7px] -left-[5px] size-[9px] rounded-full bg-brand ring-4 ring-background" aria-hidden="true"></span>
            <span class="font-mono text-xs font-semibold tracking-wider text-brand">{e.year}</span>
            <p class="mt-0.5 leading-snug"><Md text={e.text} /></p>
          </li>
        ))}
      </ol>
      <SourceList sources={h.sources} class="mt-6 border-t pt-4 text-sm" />
    </div>
  </div>
</section>
