---
// Links worth exploring: articles, videos, websites. Each card opens the resource itself.
import Md from '@/components/Md.astro';
import type { Catalog, CatalogResource } from '@/lib/catalog';
import { href } from '@/lib/nav';
import { RESOURCE_KIND } from '@/lib/resources';

interface Props {
  resources: CatalogResource[];
  /** Pass the catalog to show what each resource is about, as links. */
  catalog?: Catalog;
}

const { resources, catalog: c } = Astro.props;
const when = (d?: string) => {
  if (!d || d.length === 4) return d;
  return new Date(`${d.slice(0, 7)}-01T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
};
const topics = (r: CatalogResource) => c ? [
  ...r.concepts.map(id => ({ path: `concepts/${id}/`, name: c.concept(id).name })),
  ...r.technologies.map(id => ({ path: `technologies/${id}/`, name: c.tech(id).name })),
  ...r.architectures.map(id => ({ path: `architectures/${id}/`, name: c.architectures.find(a => a.id === id)!.title })),
] : [];
---

<div class="grid gap-3 md:grid-cols-2">
  {resources.map(r => {
    const { label, Icon } = RESOURCE_KIND[r.kind];
    return (
      <div class="group relative flex flex-col rounded-xl bg-card p-4 ring-1 ring-foreground/10 transition hover:ring-foreground/25" data-kind={r.kind}>
        <span class="flex items-center gap-1.5 font-mono text-[10px] tracking-wide text-muted-foreground uppercase">
          <Icon className="size-3.5" />{label}{r.published && <span>· {when(r.published)}</span>}
        </span>
        <a href={r.url} rel="noopener" class="mt-1.5 font-medium text-pretty after:absolute after:inset-0 after:rounded-xl group-hover:text-brand">{r.title}</a>
        <span class="mt-0.5 text-xs text-muted-foreground">{r.by}</span>
        <span class="mt-2 text-sm leading-snug text-muted-foreground"><Md text={r.summary} /></span>
        {topics(r).length > 0 && (
          <span class="relative z-10 mt-3 flex flex-wrap gap-1.5">
            {topics(r).map(t => <a href={href(t.path)} class="rounded-md bg-muted px-2 py-0.5 text-xs transition hover:bg-brand-soft hover:text-brand">{t.name}</a>)}
          </span>
        )}
      </div>
    );
  })}
</div>
