---
// Technology links in the handbook sidebar. A technology with children (EKS under Kubernetes)
// becomes a collapsible group, with its children under headings like "Managed services".
import { ChevronRightIcon } from 'lucide-react';
import type { CatalogTech } from '@/lib/catalog';
import { href, PROVIDER_SHORT, RELATION_GROUPS } from '@/lib/nav';

interface Props {
  /** In catalog order: each parent is followed by its children. */
  techs: CatalogTech[];
  active?: string;
}
const { techs, active } = Astro.props;
const top = techs.filter(t => !t.parent || !techs.some(x => x.id === t.parent!.id));
const row = (on: boolean) => [
  'flex min-w-0 flex-1 items-baseline justify-between gap-2 rounded-md px-2 py-1 text-sm transition-colors hover:bg-muted',
  on ? 'bg-brand-soft font-medium text-foreground' : 'text-foreground/80',
];
---

<ul>
  {top.map(t => {
    const kids = techs.filter(x => x.parent?.id === t.id);
    const label = (x: CatalogTech) => (
      <a href={href(`technologies/${x.id}/`)} aria-current={x.id === active ? 'page' : undefined} class:list={row(x.id === active)}>
        <span class:list={['truncate', x.archived && 'text-muted-foreground']}>{x.name}</span>
        {x.archived
          ? <span class="shrink-0 font-mono text-[10px] text-(--warn) uppercase">Archived</span>
          : <span class="shrink-0 font-mono text-[10px] text-muted-foreground uppercase">{PROVIDER_SHORT[x.provider]}</span>}
      </a>
    );
    if (!kids.length) return <li class="flex pl-[18px]">{label(t)}</li>;
    return (
      <li>
        <details data-nav={`tech:${t.id}`} open={t.id === active || kids.some(k => k.id === active)} class="group/t">
          <summary class="flex cursor-pointer list-none items-center rounded-md select-none [&::-webkit-details-marker]:hidden">
            <span class="flex w-[18px] shrink-0 justify-center" aria-hidden="true"><ChevronRightIcon className="size-3.5 text-muted-foreground transition-transform group-open/t:rotate-90" /></span>
            {label(t)}
            <span class="sr-only">, {kids.length} more</span>
          </summary>
          <ul class="mt-0.5 mb-1.5 ml-[9px] border-l pl-2">
            {kids.map((k, i) => (
              <li>
                {k.parent!.as !== kids[i - 1]?.parent!.as && (
                  <span class="mt-1.5 block px-2 font-mono text-[10px] tracking-wider text-muted-foreground uppercase">{RELATION_GROUPS[k.parent!.as]}</span>
                )}
                <span class="flex">{label(k)}</span>
              </li>
            ))}
          </ul>
        </details>
      </li>
    );
  })}
</ul>
