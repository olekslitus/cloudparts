---
// The handbook sidebar: part › topic › concept › kind › technology, each level collapsible.
// The branch holding the current page starts open; others remember their state (see Base.astro).
import { ChevronRightIcon } from 'lucide-react';
import NavTechs from '@/components/NavTechs.astro';
import type { Catalog } from '@/lib/catalog';
import { href } from '@/lib/nav';

interface Props {
  catalog: Catalog;
  /** What kind of page this is, so the right id is highlighted. */
  page?: 'topic' | 'concept' | 'kind' | 'tech';
  active?: string;
  activePart?: string;
  /** The concept holding the current page; it starts open. */
  activeConcept?: string;
}
const { catalog: c, page, active, activePart, activeConcept } = Astro.props;
const partSummary = 'flex cursor-pointer list-none items-start gap-1.5 rounded-md px-2 py-1.5 select-none hover:bg-muted [&::-webkit-details-marker]:hidden';
const chevron = 'flex w-[18px] shrink-0 justify-center';
const conceptRow = (on: boolean) => [
  'flex min-w-0 flex-1 items-baseline gap-2 rounded-md px-2 py-1 text-sm transition-colors hover:bg-muted',
  on ? 'bg-brand-soft font-medium text-foreground' : 'text-foreground/80',
];
const subhead = (on: boolean) => [
  'mt-1 flex items-baseline justify-between gap-2 rounded-md px-2 py-0.5 font-mono text-[10px] tracking-wider uppercase transition-colors hover:bg-muted hover:text-foreground',
  on ? 'bg-brand-soft text-foreground' : 'text-muted-foreground',
];
---

{c.parts.map(part => (
  <details data-nav={`part:${part.id}`} open={part.id === activePart} class="group/part mb-1">
    <summary class={partSummary}>
      <ChevronRightIcon className="mt-0.5 size-3.5 shrink-0 text-muted-foreground transition-transform group-open/part:rotate-90" />
      <span class="min-w-0">
        <span class="block text-sm font-semibold">{part.name}</span>
        <span class="block truncate text-xs text-muted-foreground group-open/part:hidden">{part.categories.map(cat => cat.name).join(' · ')}</span>
      </span>
    </summary>
    <div class="mt-1 mb-4 ml-[15px] border-l pl-1">
      {part.categories.map(cat => {
        const on = page === 'topic' && cat.id === active;
        return (
          <div class="mb-3">
            <a
              href={href(`topics/${cat.id}/`)}
              aria-current={on ? 'page' : undefined}
              class:list={['ml-[18px] flex justify-between rounded-md px-2 py-1 font-mono text-[11px] font-medium tracking-wider uppercase transition-colors hover:bg-muted hover:text-foreground', on ? 'bg-brand-soft text-foreground' : 'text-muted-foreground']}
            ><span>{cat.name}</span><span>{cat.code}</span></a>
            <ul>
              {c.concepts.filter(p => p.category === cat.id).map(p => {
                const techs = c.technologies.filter(t => t.concepts[0] === p.id);
                const here = page === 'concept' && p.id === active;
                const link = (
                  <a href={href(`concepts/${p.id}/`)} aria-current={here ? 'page' : undefined} class:list={conceptRow(here)}>
                    <span class:list={['w-12 shrink-0 font-mono text-[11px]', here ? 'text-brand' : 'text-muted-foreground']}>{p.code}</span>
                    <span class="min-w-0 flex-1">{p.name}</span>
                    {techs.length > 0 && <span class="shrink-0 font-mono text-[10px] text-muted-foreground">{techs.length}</span>}
                  </a>
                );
                if (!techs.length) return <li class="flex pl-[18px]">{link}</li>;
                return (
                  <li>
                    <details data-nav={`concept:${p.id}`} open={p.id === activeConcept} class="group/c">
                      <summary class="flex cursor-pointer list-none items-center rounded-md select-none [&::-webkit-details-marker]:hidden">
                        <span class={chevron} aria-hidden="true"><ChevronRightIcon className="size-3.5 text-muted-foreground transition-transform group-open/c:rotate-90" /></span>
                        {link}
                      </summary>
                      <div class="mt-0.5 mb-2 ml-[9px] border-l pl-1">
                        {p.kinds.length ? p.kinds.map(k => {
                          const members = techs.filter(t => t.kind === k.id);
                          return (
                            <div class="mb-1">
                              <a href={href(`concepts/${p.id}/${k.id}/`)} aria-current={page === 'kind' && k.id === active ? 'page' : undefined} class:list={['ml-[18px]', ...subhead(page === 'kind' && k.id === active)]}>
                                <span>{k.name}</span><span>{members.length}</span>
                              </a>
                              <NavTechs techs={members} active={page === 'tech' ? active : undefined} />
                            </div>
                          );
                        }) : <NavTechs techs={techs} active={page === 'tech' ? active : undefined} />}
                      </div>
                    </details>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </div>
  </details>
))}
