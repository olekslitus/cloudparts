---
// "On this page" links for small screens, where the sidebar is hidden. Wide screens show the same list in the sidebar.
interface Props { items: { id: string; label: string }[] }
const { items } = Astro.props;
---

{items.length > 2 && (
  <nav aria-label="On this page" class="mt-6 lg:hidden">
    <span class="mb-2 block font-mono text-[11px] tracking-widest text-muted-foreground uppercase">On this page</span>
    <div class="flex flex-wrap gap-1.5">
      {items.map(i => <a href={`#${i.id}`} class="rounded-full border px-2.5 py-0.5 text-sm text-muted-foreground transition hover:border-foreground/30 hover:text-foreground">{i.label}</a>)}
    </div>
  </nav>
)}
