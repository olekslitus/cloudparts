---
import MakerPage from '@/components/MakerPage.astro';
import { getCatalog } from '@/lib/catalog';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.foundations.filter(f => f.type === 'company').map(f => ({ params: { id: f.id } }));
}
---

<MakerPage id={Astro.params.id} />
