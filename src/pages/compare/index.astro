---
import { ArrowRightIcon } from 'lucide-react';
import Base from '@/layouts/Base.astro';
import { getCatalog } from '@/lib/catalog';
import { href } from '@/lib/nav';

const c = await getCatalog();
---

<Base title="Comparisons" section="compare">
  <header class="max-w-3xl">
    <div class="mb-3 font-mono text-xs tracking-wider text-muted-foreground uppercase">{c.comparisons.length} comparisons</div>
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Things that sound alike</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted-foreground">Each of these pairs or trios of concepts or products gets mixed up in design reviews. Here’s how they actually differ.</p>
  </header>
  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {c.comparisons.map(m => (
      <a href={href(`compare/${m.id}/`)} class="group flex flex-col rounded-xl bg-card p-5 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
        <span class="flex items-center justify-between gap-3">
          <span class="text-lg font-semibold">{m.title}</span>
          <ArrowRightIcon className="size-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-foreground" />
        </span>
        <span class="mt-2 flex flex-wrap gap-1.5">
          {m.columns.map(col => <span class="rounded-md bg-muted px-2 py-0.5 text-xs">{col.name}</span>)}
        </span>
        <span class="mt-3 line-clamp-2 text-sm text-muted-foreground">{m.tip}</span>
      </a>
    ))}
  </div>
</Base>
