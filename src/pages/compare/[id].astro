---
import Md from '@/components/Md.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import SourceList from '@/components/SourceList.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog, type CatalogComparison } from '@/lib/catalog';
import { href } from '@/lib/nav';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.comparisons.map(m => ({ params: { id: m.id } }));
}

const c = await getCatalog();
const m = c.comparisons.find(x => x.id === Astro.params.id) as CatalogComparison;
---

<Base title={m.title} description={m.tip} section="compare">
  <Breadcrumbs items={[{ label: 'Comparisons', path: 'compare/' }]} />
  <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{m.title}</h1>

  <nav class="mt-6 inline-flex max-w-full flex-wrap gap-1 rounded-lg bg-muted p-1" aria-label="Comparisons">
    {c.comparisons.map(x => (
      <a
        href={href(`compare/${x.id}/`)}
        aria-current={x.id === m.id ? 'page' : undefined}
        class:list={[
          'rounded-md px-3 py-1 text-sm font-medium transition',
          x.id === m.id ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground',
        ]}
      >{x.title}</a>
    ))}
  </nav>

  <div class="mt-8 overflow-x-auto rounded-xl bg-card ring-1 ring-foreground/10">
    <table class="w-full min-w-[640px] border-collapse text-left">
      <thead>
        <tr class="border-b bg-muted/50">
          <th scope="col" class="w-44 px-4 py-3"><span class="sr-only">Dimension</span></th>
          {m.columns.map(col => (
            <th scope="col" class="px-4 py-3 align-bottom">
              <a href={href(col.href)} class="group block">
                <span class="block font-mono text-[10px] font-normal text-muted-foreground">{col.code}</span>
                <span class="font-semibold group-hover:text-brand">{col.name}</span>
              </a>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {m.rows.map(r => (
          <tr class="border-b last:border-b-0">
            <th scope="row" class="px-4 py-3 align-top font-mono text-[11px] font-medium tracking-wide text-muted-foreground uppercase">{r.label}</th>
            {r.values.map(v => <td class="px-4 py-3 align-top text-[15px] leading-snug"><Md text={v} /></td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="mt-8 rounded-xl border-l-4 border-brand bg-brand-soft/60 px-5 py-4">
    <SectionLabel class="mb-1.5 text-brand">Rule of thumb</SectionLabel>
    <p class="max-w-3xl text-[17px] leading-relaxed"><Md text={m.tip} /></p>
  </section>

  <section class="mt-14 border-t pt-6 text-sm">
    <SectionLabel>Sources</SectionLabel>
    <SourceList sources={m.sources} />
  </section>
</Base>
