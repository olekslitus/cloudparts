---
import { ExternalLinkIcon, PencilIcon } from 'lucide-react';
import History from '@/components/History.astro';
import Md from '@/components/Md.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import SourceList from '@/components/SourceList.astro';
import TechCard from '@/components/TechCard.astro';
import TechSection from '@/components/TechSection.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog, type CatalogFoundation } from '@/lib/catalog';
import { REPO_URL } from '@/lib/nav';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.foundations.map(f => ({ params: { id: f.id } }));
}

const c = await getCatalog();
const f = c.foundations.find(x => x.id === Astro.params.id) as CatalogFoundation;
const anchors = f.sections.map(s => s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''));
const repo = REPO_URL;
const pill = 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs';
---

<Base title={f.name} description={f.summary} section="technologies">
  <article>
    <header class="max-w-3xl">
      <Breadcrumbs items={[{ label: 'All technologies', path: 'technologies/' }, { label: 'Foundations' }]} />
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{f.name}</h1>
      <p class="mt-3 text-lg leading-relaxed text-pretty text-muted-foreground"><Md text={f.summary} /></p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class={pill}>{f.projects.length} projects in this catalog</span>
        <a href={f.website} class:list={[pill, 'transition hover:bg-muted']} rel="noopener">Website <ExternalLinkIcon className="size-3" /></a>
      </div>
    </header>

    <section class="mt-10 max-w-3xl">
      <SectionLabel>What it is</SectionLabel>
      <div class="space-y-4 text-[17px] leading-relaxed">
        {f.intro.map(p => <p><Md text={p} /></p>)}
      </div>
    </section>

    <section class="mt-12">
      <SectionLabel>Its projects in this catalog</SectionLabel>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {f.projects.map(t => <TechCard tech={t} />)}
      </div>
    </section>

    {f.sections.length > 0 && (
      <div class="mt-16 border-t pt-10">
        <SectionLabel>In depth</SectionLabel>
        <nav class="flex flex-wrap gap-2" aria-label="On this page">
          {f.sections.map((s, i) => (
            <a href={`#${anchors[i]}`} class="rounded-full border px-3 py-1 text-sm text-muted-foreground transition hover:border-foreground/30 hover:text-foreground">{s.title}</a>
          ))}
        </nav>
        {f.sections.map((s, i) => <TechSection section={s} anchor={anchors[i]} catalog={c} />)}
      </div>
    )}

    <History history={f.history} />

    <section class="mt-14 border-t pt-6 text-sm">
      <SectionLabel>Sources · facts checked {f.checked}</SectionLabel>
      <SourceList sources={f.sources} />
      {repo && (
        <p class="mt-6 text-muted-foreground">
          <a href={`${repo}/edit/main/content/foundations/${f.id}.json`} class="inline-flex items-center gap-1.5 underline-offset-4 hover:text-foreground hover:underline">
            <PencilIcon className="size-3.5" />Improve this page on GitHub
          </a>
        </p>
      )}
    </section>
  </article>
</Base>
