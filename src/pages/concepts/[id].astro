---
import { Code } from 'astro:components';
import { ArrowLeftIcon, ArrowLeftRightIcon, ArrowRightIcon, CheckIcon, PencilIcon, XIcon } from 'lucide-react';
import ArchCard from '@/components/ArchCard.astro';
import BenchmarkList from '@/components/BenchmarkList.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CopyCode from '@/components/CopyCode.astro';
import History from '@/components/History.astro';
import LiveModel from '@/components/LiveModel';
import Md from '@/components/Md.astro';
import ResourceList from '@/components/ResourceList.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import SourceList from '@/components/SourceList.astro';
import TechCard from '@/components/TechCard.astro';
import TechSection from '@/components/TechSection.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog, type CatalogConcept } from '@/lib/catalog';
import { diagramLinks } from '@/lib/links';
import { href } from '@/lib/nav';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.concepts.map(p => ({ params: { id: p.id } }));
}

const c = await getCatalog();
const p = c.concept(Astro.params.id) as CatalogConcept;
const cat = c.category(p.category);
const part = c.part(cat.part);
const i = c.concepts.indexOf(p);
const prev = c.concepts[(i - 1 + c.concepts.length) % c.concepts.length];
const next = c.concepts[(i + 1) % c.concepts.length];
const compares = c.comparisons.filter(m => m.concepts.includes(p.id));
const techs = c.techsFor(p.id);
const archs = c.archsWithConcept(p.id);
const resources = c.resourcesAbout('concepts', p.id);
const benchmarks = c.benchmarksAbout('concepts', p.id);
const repo = import.meta.env.PUBLIC_REPO_URL as string | undefined;
const providers = p.providers && [
  ['AWS', p.providers.aws],
  ['Google Cloud', p.providers.gcp],
  ['Azure', p.providers.azure],
  ['Open source & others', p.providers.oss],
];
const anchors = p.sections.map(s => s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''));
---

<Base title={p.name} description={p.summary} active={p.id} section="concepts">
  <article>
    <header class="max-w-3xl">
      <Breadcrumbs items={[{ label: part.name, path: `concepts/#${part.id}` }, { label: cat.name, path: `topics/${cat.id}/` }]} code={p.code} />
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{p.name}</h1>
      <p class="mt-3 text-lg leading-relaxed text-pretty text-muted-foreground"><Md text={p.summary} /></p>
    </header>

    {p.diagram && (
      <div class="mt-8">
        <LiveModel client:visible diagram={p.diagram} links={diagramLinks(c, p.diagram, { concept: p.id })} />
      </div>
    )}

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
      <section>
        <SectionLabel>How it works</SectionLabel>
        <p class="text-[17px] leading-relaxed"><Md text={p.howItWorks} /></p>
        <div class="mt-6 rounded-xl border-l-4 border-(--p2) bg-muted/50 px-4 py-3.5">
          <SectionLabel class="mb-1.5 text-(--p2)">Think of it as</SectionLabel>
          <p class="leading-relaxed text-foreground/90 italic"><Md text={p.analogy} /></p>
        </div>
      </section>
      <section class="grid content-start gap-8">
        <div>
          <SectionLabel>Reach for it when</SectionLabel>
          <ul class="space-y-2.5">
            {p.useWhen.map(u => (
              <li class="flex gap-2.5 leading-snug">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-(--ok)/15 text-(--ok)"><CheckIcon className="size-3.5" /></span>
                <span><Md text={u} /></span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <SectionLabel>Think twice when</SectionLabel>
          <ul class="space-y-2.5">
            {p.avoidWhen.map(u => (
              <li class="flex gap-2.5 leading-snug">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-(--bad)/15 text-(--bad)"><XIcon className="size-3.5" /></span>
                <span><Md text={u} /></span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <section class="mt-12 rounded-xl bg-card p-5 ring-1 ring-foreground/10 sm:p-6">
      <SectionLabel>A real example</SectionLabel>
      <p class="max-w-3xl text-[17px] leading-relaxed"><Md text={p.example} /></p>
    </section>

    {p.sections.length > 0 && (
      <div class="mt-4">
        {p.sections.map((s, i) => <TechSection section={s} anchor={anchors[i]} catalog={c} />)}
      </div>
    )}

    {providers && (
    <section class="mt-12">
      <SectionLabel>What each provider calls it</SectionLabel>
      <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {providers.map(([label, value]) => (
          <div class="rounded-xl bg-card px-4 py-3 ring-1 ring-foreground/10">
            <dt class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{label}</dt>
            <dd class="mt-1 text-sm font-medium">{value}</dd>
          </div>
        ))}
      </dl>
    </section>
    )}

    {p.history && <History history={p.history} />}

    {techs.length > 0 && (
      <section class="mt-12">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <SectionLabel class="mb-0">{p.kinds.length ? `Kinds of ${p.name.toLowerCase()}` : 'Technologies'}</SectionLabel>
          <span class="text-sm text-muted-foreground">Specific products, and what each does differently</span>
        </div>
        {p.kinds.length ? (
          <div class="grid gap-8">
            {p.kinds.map(k => (
              <div class="grid gap-3 lg:grid-cols-[220px_minmax(0,1fr)]">
                <a href={href(`concepts/${p.id}/${k.id}/`)} class="group self-start">
                  <span class="flex items-center gap-1 font-medium group-hover:text-brand">{k.name}<ArrowRightIcon className="size-3.5 opacity-0 transition group-hover:translate-x-0.5 group-hover:opacity-100" /></span>
                  <span class="mt-0.5 block text-sm leading-snug text-muted-foreground">{k.summary}</span>
                </a>
                <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                  {c.techsOfKind(k.id).filter(t => !t.parent).map(t => <TechCard tech={t} family={c.childrenOf(t.id)} also={t.concepts[0] !== p.id ? c.concept(t.concepts[0]).name : undefined} />)}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {techs.filter(t => !t.parent).map(t => <TechCard tech={t} family={c.childrenOf(t.id)} also={t.concepts[0] !== p.id ? c.concept(t.concepts[0]).name : undefined} />)}
          </div>
        )}
      </section>
    )}

    {archs.length > 0 && (
      <section class="mt-12">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <SectionLabel class="mb-0">See it in a real stack</SectionLabel>
          <span class="text-sm text-muted-foreground">Architectures that use {p.name.toLowerCase()}</span>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {archs.map(a => <ArchCard arch={a} catalog={c} />)}
        </div>
      </section>
    )}

    {p.snippet && (
    <section class="mt-12" data-codebox>
      <div class="mb-3 flex items-center justify-between gap-2">
        <SectionLabel class="mb-0">In code · {p.snippet.lang}</SectionLabel>
        <button type="button" data-copy class="inline-flex h-7 items-center gap-1.5 rounded-md border bg-background px-2.5 text-xs font-medium transition hover:bg-muted">Copy</button>
      </div>
      <div class="overflow-hidden rounded-xl bg-muted/50 ring-1 ring-foreground/10 [&_pre]:overflow-x-auto [&_pre]:p-4 [&_pre]:font-mono [&_pre]:text-[13px] [&_pre]:leading-relaxed">
        <Code code={p.snippet.source} lang={p.snippet.lang} themes={{ light: 'github-light', dark: 'github-dark' }} />
      </div>
    </section>
    )}

    {resources.length > 0 && (
      <section class="mt-12">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <SectionLabel class="mb-0">Worth exploring</SectionLabel>
          <a href={href('resources/')} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">All resources →</a>
        </div>
        <ResourceList resources={resources} />
      </section>
    )}

    {benchmarks.length > 0 && (
      <section class="mt-12">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <SectionLabel class="mb-0">Benchmarks</SectionLabel>
          <a href={href('benchmarks/')} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">How to read a benchmark →</a>
        </div>
        <BenchmarkList benchmarks={benchmarks} catalog={c} />
      </section>
    )}

    <section class="mt-12 border-t pt-6">
      <SectionLabel>Often confused with</SectionLabel>
      <div class="flex flex-wrap gap-2">
        {p.related.map(id => {
          const r = c.concept(id);
          return (
            <a href={href(`concepts/${id}/`)} class="inline-flex items-baseline gap-2 rounded-lg border bg-background px-3 py-1.5 text-sm font-medium transition hover:border-foreground/30 hover:bg-muted">
              <span class="font-mono text-[10px] text-muted-foreground">{r.code}</span>{r.name}
            </a>
          );
        })}
        {compares.map(m => (
          <a href={href(`compare/${m.id}/`)} class="inline-flex items-center gap-2 rounded-lg border border-dashed px-3 py-1.5 text-sm font-medium transition hover:border-foreground/30 hover:bg-muted">
            <ArrowLeftRightIcon className="size-3.5 text-muted-foreground" />{m.title}
          </a>
        ))}
      </div>
    </section>

    <nav class="mt-12 grid gap-3 sm:grid-cols-2" aria-label="Previous and next concept">
      <a href={href(`concepts/${prev.id}/`)} class="group rounded-xl px-4 py-3 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
        <span class="flex items-center gap-1 font-mono text-[11px] tracking-wider text-muted-foreground uppercase"><ArrowLeftIcon className="size-3" />{prev.code}</span>
        <span class="mt-0.5 block font-medium">{prev.name}</span>
      </a>
      <a href={href(`concepts/${next.id}/`)} class="group rounded-xl px-4 py-3 text-right ring-1 ring-foreground/10 transition hover:ring-foreground/25">
        <span class="flex items-center justify-end gap-1 font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{next.code}<ArrowRightIcon className="size-3" /></span>
        <span class="mt-0.5 block font-medium">{next.name}</span>
      </a>
    </nav>

    <section class="mt-14 border-t pt-6 text-sm">
      <SectionLabel>Sources</SectionLabel>
      <SourceList sources={p.sources} />
    </section>

    {repo && (
      <p class="mt-8 text-sm text-muted-foreground">
        <a href={`${repo}/edit/main/content/concepts/${p.id}.json`} class="inline-flex items-center gap-1.5 underline-offset-4 hover:text-foreground hover:underline">
          <PencilIcon className="size-3.5" />Improve this page on GitHub
        </a>
      </p>
    )}
  </article>
</Base>

<CopyCode />
