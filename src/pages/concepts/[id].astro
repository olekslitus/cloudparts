---
import { Code } from 'astro:components';
import { ArrowLeftIcon, ArrowLeftRightIcon, ArrowRightIcon, CheckIcon, PencilIcon, XIcon } from 'lucide-react';
import ArchCard from '@/components/ArchCard.astro';
import BenchmarkList from '@/components/BenchmarkList.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CopyCode from '@/components/CopyCode.astro';
import History from '@/components/History.astro';
import LiveModel from '@/components/LiveModel';
import Md from '@/components/Md.astro';
import ResourceList from '@/components/ResourceList.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import Sources from '@/components/Sources.astro';
import TechListing from '@/components/TechListing.astro';
import TechSection from '@/components/TechSection.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog, type CatalogConcept } from '@/lib/catalog';
import { diagramLinks } from '@/lib/links';
import { href, REPO_URL } from '@/lib/nav';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.concepts.map(p => ({ params: { id: p.id } }));
}

const c = await getCatalog();
const p = c.concept(Astro.params.id) as CatalogConcept;
const cat = c.category(p.category);
const part = c.part(cat.part);
const i = c.concepts.indexOf(p);
const prev = c.concepts[(i - 1 + c.concepts.length) % c.concepts.length];
const next = c.concepts[(i + 1) % c.concepts.length];
const compares = c.comparisons.filter(m => m.concepts.includes(p.id));
const techs = c.techsFor(p.id);
const archs = c.archsWithConcept(p.id);
const resources = c.resourcesAbout('concepts', p.id);
const benchmarks = c.benchmarksAbout('concepts', p.id);
const repo = REPO_URL;
const providers = p.providers && [
  ['AWS', p.providers.aws],
  ['Google Cloud', p.providers.gcp],
  ['Azure', p.providers.azure],
  ['Open source & others', p.providers.oss],
];
const anchors = p.sections.map(s => s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''));
const top = techs.filter(t => !t.parent);
// kinds group the technologies with a page each; otherwise the concept's own groups, then everything else
const grouped = new Set(p.groups.flatMap(g => g.technologies));
const groups = p.kinds.length
  ? p.kinds.map(k => ({ name: k.name, summary: k.summary, path: `concepts/${p.id}/${k.id}/`, techs: c.techsOfKind(k.id).filter(t => !t.parent) }))
  : p.groups.length
    ? [
        ...p.groups.map(g => ({ name: g.name, summary: g.summary, techs: g.technologies.map(id => c.tech(id)) })),
        ...(top.some(t => !grouped.has(t.id)) ? [{ name: 'Other', techs: top.filter(t => !grouped.has(t.id)) }] : []),
      ]
    : [{ techs: top }];
const techCount = top.length;
const outline = [
  { id: 'how', label: 'How it works' },
  { id: 'when', label: 'Reach for it when' },
  { id: 'avoid', label: 'Think twice when' },
  { id: 'example', label: 'A real example' },
  ...(techCount ? [{ id: 'technologies', label: p.kinds.length ? `Kinds of ${p.name.toLowerCase()}` : 'Technologies' }] : []),
  ...(providers ? [{ id: 'providers', label: 'What each provider calls it' }] : []),
  ...p.sections.map((s, i) => ({ id: anchors[i], label: s.title })),
  ...(archs.length ? [{ id: 'stack', label: 'In a real stack' }] : []),
  ...(p.snippet ? [{ id: 'code', label: 'In code' }] : []),
  ...(resources.length ? [{ id: 'resources', label: 'Worth exploring' }] : []),
  ...(benchmarks.length ? [{ id: 'benchmarks', label: 'Benchmarks' }] : []),
  { id: 'confused', label: 'Often confused with' },
  ...(p.history ? [{ id: 'history', label: 'Where it came from' }] : []),
  { id: 'sources', label: 'Sources' },
];
---

<Base title={p.name} description={p.summary} active={p.id} section="concepts" outline={outline}>
  <article class="mx-auto max-w-[50rem]">
    <header>
      <Breadcrumbs items={[{ label: part.name, path: `concepts/#${part.id}` }, { label: cat.name, path: `topics/${cat.id}/` }]} />
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{p.name}</h1>
      <p class="mt-3 text-lg leading-relaxed text-pretty text-muted-foreground"><Md text={p.summary} /></p>
      {techCount > 0 && <a href="#technologies" class="mt-3 inline-block text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">{techCount} {techCount === 1 ? 'technology' : 'technologies'} on this page ↓</a>}
    </header>

    {p.diagram && (
      <div class="mt-8">
        <LiveModel client:visible diagram={p.diagram} links={diagramLinks(c, p.diagram, { concept: p.id })} />
      </div>
    )}

    <section id="how" class="mt-12 scroll-mt-20">
      <SectionLabel>How it works</SectionLabel>
      <p class="text-[17px] leading-relaxed"><Md text={p.howItWorks} /></p>
      <div class="mt-6 rounded-xl border-l-4 border-(--p2) bg-muted/50 px-4 py-3.5">
        <span class="mb-1.5 block font-mono text-[11px] font-medium tracking-widest text-(--p2) uppercase">Think of it as</span>
        <p class="leading-relaxed text-foreground/90 italic"><Md text={p.analogy} /></p>
      </div>
    </section>

    <section id="when" class="mt-10 scroll-mt-20">
      <SectionLabel>Reach for it when</SectionLabel>
      <ul class="space-y-2.5">
        {p.useWhen.map(u => (
          <li class="flex gap-2.5 leading-snug">
            <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-(--ok)/15 text-(--ok)"><CheckIcon className="size-3.5" /></span>
            <span><Md text={u} /></span>
          </li>
        ))}
      </ul>
    </section>

    <section id="avoid" class="mt-10 scroll-mt-20">
      <SectionLabel>Think twice when</SectionLabel>
      <ul class="space-y-2.5">
        {p.avoidWhen.map(u => (
          <li class="flex gap-2.5 leading-snug">
            <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-(--bad)/15 text-(--bad)"><XIcon className="size-3.5" /></span>
            <span><Md text={u} /></span>
          </li>
        ))}
      </ul>
    </section>

    <section id="example" class="mt-12 scroll-mt-20 rounded-xl bg-card p-5 ring-1 ring-foreground/10 sm:p-6">
      <SectionLabel>A real example</SectionLabel>
      <p class="text-[17px] leading-relaxed"><Md text={p.example} /></p>
    </section>

    {techCount > 0 && (
      <section id="technologies" class="mt-14 scroll-mt-20">
        <h2 class="text-2xl font-semibold tracking-tight">{p.kinds.length ? `Kinds of ${p.name.toLowerCase()}` : 'Technologies'}</h2>
        <p class="mt-1 mb-5 text-muted-foreground">Specific products, and what each does differently.</p>
        <TechListing catalog={c} concept={p.id} groups={groups} />
      </section>
    )}

    {providers && (
      <section id="providers" class="mt-14 scroll-mt-20">
        <SectionLabel>What each provider calls it</SectionLabel>
        <dl class="divide-y overflow-hidden rounded-xl bg-card ring-1 ring-foreground/10">
          {providers.map(([label, value]) => (
            <div class="grid gap-0.5 px-4 py-2.5 sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-4">
              <dt class="text-sm text-muted-foreground">{label}</dt>
              <dd class="text-[15px]">{value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {p.sections.length > 0 && (
      <div class="mt-4">
        {p.sections.map((s, i) => <TechSection section={s} anchor={anchors[i]} catalog={c} />)}
      </div>
    )}

    {archs.length > 0 && (
      <section id="stack" class="mt-14 scroll-mt-20">
        <SectionLabel>See it in a real stack</SectionLabel>
        <p class="-mt-1 mb-3 text-sm text-muted-foreground">Architectures that use {p.name.toLowerCase()}</p>
        <div class="grid gap-2">
          {archs.map(a => <ArchCard arch={a} catalog={c} />)}
        </div>
      </section>
    )}

    {p.snippet && (
      <section id="code" class="mt-12 scroll-mt-20" data-codebox>
        <div class="mb-3 flex items-center justify-between gap-2">
          <SectionLabel class="mb-0">In code · {p.snippet.lang}</SectionLabel>
          <button type="button" data-copy class="inline-flex h-7 items-center gap-1.5 rounded-md border bg-background px-2.5 text-xs font-medium transition hover:bg-muted">Copy</button>
        </div>
        <div class="overflow-hidden rounded-xl bg-muted/50 ring-1 ring-foreground/10 [&_pre]:overflow-x-auto [&_pre]:p-4 [&_pre]:font-mono [&_pre]:text-[13px] [&_pre]:leading-relaxed">
          <Code code={p.snippet.source} lang={p.snippet.lang} themes={{ light: 'github-light', dark: 'github-dark' }} />
        </div>
      </section>
    )}

    {resources.length > 0 && (
      <section id="resources" class="mt-12 scroll-mt-20">
        <SectionLabel>Worth exploring</SectionLabel>
        <ResourceList resources={resources} />
        <a href={href('resources/')} class="mt-3 inline-block text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">All resources →</a>
      </section>
    )}

    {benchmarks.length > 0 && (
      <section id="benchmarks" class="mt-12 scroll-mt-20">
        <SectionLabel>Benchmarks</SectionLabel>
        <BenchmarkList benchmarks={benchmarks} catalog={c} />
        <a href={href('benchmarks/')} class="mt-3 inline-block text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">How to read a benchmark →</a>
      </section>
    )}

    <section id="confused" class="mt-12 scroll-mt-20 border-t pt-6">
      <SectionLabel>Often confused with</SectionLabel>
      <div class="flex flex-wrap gap-2">
        {p.related.map(id => (
          <a href={href(`concepts/${id}/`)} class="inline-flex items-center rounded-lg border bg-background px-3 py-1.5 text-sm font-medium transition hover:border-foreground/30 hover:bg-muted">{c.concept(id).name}</a>
        ))}
        {compares.map(m => (
          <a href={href(`compare/${m.id}/`)} class="inline-flex items-center gap-2 rounded-lg border border-dashed px-3 py-1.5 text-sm font-medium transition hover:border-foreground/30 hover:bg-muted">
            <ArrowLeftRightIcon className="size-3.5 text-muted-foreground" />{m.title}
          </a>
        ))}
      </div>
    </section>

    {p.history && <History history={p.history} />}

    <Sources sources={p.sources} />

    <nav class="mt-12 grid gap-2" aria-label="Previous and next concept">
      <a href={href(`concepts/${prev.id}/`)} class="group flex items-center gap-3 rounded-xl px-4 py-3 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
        <ArrowLeftIcon className="size-4 shrink-0 text-muted-foreground" />
        <span><span class="block text-xs text-muted-foreground">Previous concept</span><span class="font-medium group-hover:text-brand">{prev.name}</span></span>
      </a>
      <a href={href(`concepts/${next.id}/`)} class="group flex items-center justify-end gap-3 rounded-xl px-4 py-3 text-right ring-1 ring-foreground/10 transition hover:ring-foreground/25">
        <span><span class="block text-xs text-muted-foreground">Next concept</span><span class="font-medium group-hover:text-brand">{next.name}</span></span>
        <ArrowRightIcon className="size-4 shrink-0 text-muted-foreground" />
      </a>
    </nav>

    {repo && (
      <p class="mt-8 text-sm text-muted-foreground">
        <a href={`${repo}/edit/main/content/concepts/${p.id}.json`} class="inline-flex items-center gap-1.5 underline-offset-4 hover:text-foreground hover:underline">
          <PencilIcon className="size-3.5" />Improve this page on GitHub
        </a>
      </p>
    )}
  </article>
</Base>

<CopyCode />
