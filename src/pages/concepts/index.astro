---
import Glyph from '@/components/Glyph.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog } from '@/lib/catalog';
import { href } from '@/lib/nav';

const c = await getCatalog();
---

<Base title="Concepts" description="The ideas behind modern software and the products that implement them, in five areas: build, infrastructure, data, ship and run, and teams." section="concepts">
  <header class="max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Concepts</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted-foreground">
      Start from an idea, then go deeper to the products. Learn what a queue or a table format does once, and every product that implements it makes sense. {c.concepts.length} concepts in {c.parts.length} areas.
    </p>
    <a href={href('technologies/')} class="mt-3 inline-flex items-center gap-1.5 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Looking for a product? Search all {c.technologies.length} technologies →</a>
  </header>


  <div class="max-w-[50rem]">
    {c.parts.map(part => (
      <section id={part.id} class="mt-14 scroll-mt-20" aria-labelledby={`${part.id}-h`}>
        <div class="border-b pb-2">
          <h2 id={`${part.id}-h`} class="text-2xl font-semibold tracking-tight">{part.name}</h2>
          <p class="mt-0.5 text-sm text-muted-foreground">{part.blurb}</p>
        </div>
        {part.categories.map(cat => (
          <section class="mt-6">
            <a href={href(`topics/${cat.id}/`)} class="group inline-block">
              <h3 class="flex items-center gap-2 font-semibold group-hover:text-brand"><Glyph icon={cat.icon} class="size-4" />{cat.name} <span class="text-sm font-normal text-muted-foreground opacity-0 transition group-hover:opacity-100">topic page →</span></h3>
              <span class="block text-sm text-muted-foreground">{cat.blurb}</span>
            </a>
            <ul class="mt-2 divide-y overflow-hidden rounded-xl bg-card ring-1 ring-foreground/10">
              {c.concepts.filter(p => p.category === cat.id).map(p => {
                const k = c.techsFor(p.id).filter(t => !t.parent).length + c.usedFor(p.id).length;
                return (
                  <li>
                    <a href={href(`concepts/${p.id}/`)} class="group flex gap-3 px-4 py-2.5 transition-colors hover:bg-muted/60" style={p.parent ? `padding-left: ${16 + 28 * c.ancestors(p.id).length}px` : undefined}>
                      <Glyph icon={p.icon} class="mt-0.5 size-5" />
                      <span class="min-w-0 flex-1">
                      <span class="flex items-baseline justify-between gap-2">
                        <span class="font-medium group-hover:text-brand">{p.name}</span>
                        {k > 0 && <span class="shrink-0 text-xs text-muted-foreground">{k} {k === 1 ? 'technology' : 'technologies'}</span>}
                      </span>
                      <span class="block text-sm leading-snug text-muted-foreground">{p.summary}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </section>
    ))}
  </div>
</Base>
