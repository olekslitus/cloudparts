---
import Base from '@/layouts/Base.astro';
import { getCatalog } from '@/lib/catalog';
import { href } from '@/lib/nav';

const c = await getCatalog();
---

<Base title="Handbook" description="The ideas behind modern software and the products that implement them, in five parts: build, infrastructure, data, ship and run, and teams." section="concepts">
  <header class="max-w-3xl">
    <div class="mb-3 font-mono text-xs tracking-wider text-muted-foreground uppercase">{c.parts.length} parts · {c.categories.length} topics · {c.concepts.length} concepts · {c.technologies.length} technologies</div>
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Handbook</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted-foreground">
      Start from an idea, then go deeper to the products. Learn what a queue or a table format does once, and every product that implements it makes sense.
      Each topic opens into concepts, kinds and the technologies themselves.
    </p>
    <a href={href('technologies/')} class="mt-4 inline-flex items-center gap-1.5 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Or browse all {c.technologies.length} technologies on one page →</a>
  </header>

  <nav class="mt-8 flex flex-wrap gap-2" aria-label="Parts">
    {c.parts.map(part => <a href={`#${part.id}`} class="rounded-full border px-3 py-1 text-sm text-muted-foreground transition hover:border-foreground/30 hover:text-foreground">{part.name}</a>)}
  </nav>

  {c.parts.map((part, n) => (
    <section id={part.id} class="mt-14 scroll-mt-20" aria-labelledby={`${part.id}-h`}>
      <div class="border-b pb-2">
        <div class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">Part {n + 1}</div>
        <h2 id={`${part.id}-h`} class="text-2xl font-semibold tracking-tight">{part.name}</h2>
        <p class="mt-0.5 text-sm text-muted-foreground">{part.blurb}</p>
      </div>
      <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {part.categories.map(cat => (
          <section class="flex flex-col rounded-xl bg-card ring-1 ring-foreground/10">
            <a href={href(`topics/${cat.id}/`)} class="group block px-4 pt-4 pb-3">
              <span class="flex items-baseline gap-2">
                <span class="font-mono text-[11px] font-semibold tracking-wider text-brand">{cat.code}</span>
                <h3 class="font-semibold group-hover:text-brand">{cat.name}</h3>
                <span class="ml-auto text-xs text-muted-foreground opacity-0 transition group-hover:opacity-100">Topic page →</span>
              </span>
              <span class="mt-0.5 block text-sm text-muted-foreground">{cat.blurb}</span>
            </a>
            <ul class="border-t">
              {c.concepts.filter(p => p.category === cat.id).map(p => {
                const k = c.techsFor(p.id).length;
                return (
                  <li class="border-b last:border-b-0">
                    <a href={href(`concepts/${p.id}/`)} class="group flex gap-3 px-4 py-2.5 transition-colors hover:bg-muted/60">
                      <span class="mt-0.5 w-12 shrink-0 font-mono text-[11px] text-muted-foreground">{p.code}</span>
                      <span class="min-w-0 flex-1">
                        <span class="flex items-baseline justify-between gap-2">
                          <span class="text-sm font-medium group-hover:text-brand">{p.name}</span>
                          {k > 0 && <span class="shrink-0 font-mono text-[10px] text-muted-foreground">{k} tech</span>}
                        </span>
                        <span class="block text-sm leading-snug text-muted-foreground">{p.summary}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    </section>
  ))}
</Base>
