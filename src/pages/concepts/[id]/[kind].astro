---
import { ArrowLeftIcon, ArrowLeftRightIcon, ArrowRightIcon, PencilIcon } from 'lucide-react';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Md from '@/components/Md.astro';
import ResourceList from '@/components/ResourceList.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import SourceList from '@/components/SourceList.astro';
import TechCard from '@/components/TechCard.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog } from '@/lib/catalog';
import { href, REPO_URL } from '@/lib/nav';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.concepts.flatMap(p => p.kinds.map(k => ({ params: { id: p.id, kind: k.id } })));
}

const c = await getCatalog();
const k = c.kind(Astro.params.kind);
const p = c.concept(k.concept);
const cat = c.category(p.category);
const part = c.part(cat.part);
const i = p.kinds.findIndex(x => x.id === k.id);
const prev = p.kinds[i - 1];
const next = p.kinds[i + 1];
const techs = c.techsOfKind(k.id);
const listed = techs.filter(t => t.kind === k.id && !t.parent);
const also = techs.filter(t => t.kind !== k.id);
const ids = new Set(techs.map(t => t.id));
const compares = c.comparisons.filter(m => m.technologies.some(id => ids.has(id)));
const resources = c.resources.filter(r => r.technologies.some(id => ids.has(id)));
const repo = REPO_URL;
---

<Base title={`${k.name} · ${p.name}`} description={k.summary} active={k.id} section="kinds">
  <article>
    <header class="max-w-3xl">
      <Breadcrumbs items={[{ label: part.name, path: `concepts/#${part.id}` }, { label: cat.name, path: `topics/${cat.id}/` }, { label: p.name, path: `concepts/${p.id}/` }]} />
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{k.name}</h1>
      <p class="mt-3 text-lg leading-relaxed text-pretty text-muted-foreground"><Md text={k.summary} /></p>
    </header>

    <nav class="mt-6 flex flex-wrap items-center gap-2" aria-label={`Kinds of ${p.name.toLowerCase()}`}>
      <a href={href(`concepts/${p.id}/`)} class="mr-1 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">{p.name}:</a>
      {p.kinds.map(x => (
        <a
          href={href(`concepts/${p.id}/${x.id}/`)}
          aria-current={x.id === k.id ? 'page' : undefined}
          class:list={['rounded-full border px-3 py-1 text-sm transition', x.id === k.id ? 'border-brand/40 bg-brand-soft font-medium text-foreground' : 'text-muted-foreground hover:border-foreground/30 hover:text-foreground']}
        >{x.name}</a>
      ))}
    </nav>

    <section class="mt-10 max-w-3xl">
      <SectionLabel>How they work</SectionLabel>
      <div class="space-y-4 text-[17px] leading-relaxed">
        {k.body.map(t => <p><Md text={t} /></p>)}
      </div>
    </section>

    {listed.length > 0 && (
      <section class="mt-12">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <SectionLabel class="mb-0">Technologies</SectionLabel>
          <a href={href(`concepts/${p.id}/`)} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">What all {p.name.toLowerCase()} have in common →</a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {listed.map(t => <TechCard tech={t} family={c.childrenOf(t.id)} />)}
        </div>
      </section>
    )}

    {also.length > 0 && (
      <section class="mt-10">
        <SectionLabel>Also {k.name.toLowerCase()}</SectionLabel>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {also.map(t => <TechCard tech={t} also={c.concept(t.concepts[0]).name} />)}
        </div>
      </section>
    )}

    {compares.length > 0 && (
      <section class="mt-12">
        <SectionLabel>Compared side by side</SectionLabel>
        <div class="flex flex-wrap gap-2">
          {compares.map(m => (
            <a href={href(`compare/${m.id}/`)} class="inline-flex items-center gap-2 rounded-lg border border-dashed px-3 py-1.5 text-sm font-medium transition hover:border-foreground/30 hover:bg-muted">
              <ArrowLeftRightIcon className="size-3.5 text-muted-foreground" />{m.title}
            </a>
          ))}
        </div>
      </section>
    )}

    {resources.length > 0 && (
      <section class="mt-12">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <SectionLabel class="mb-0">Worth exploring</SectionLabel>
          <a href={href('resources/')} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">All resources →</a>
        </div>
        <ResourceList resources={resources} />
      </section>
    )}

    <nav class="mt-12 grid gap-3 sm:grid-cols-2" aria-label={`Previous and next kind of ${p.name.toLowerCase()}`}>
      {prev ? (
        <a href={href(`concepts/${p.id}/${prev.id}/`)} class="group rounded-xl px-4 py-3 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
          <span class="flex items-center gap-1 font-mono text-[11px] tracking-wider text-muted-foreground uppercase"><ArrowLeftIcon className="size-3" />{p.name}</span>
          <span class="mt-0.5 block font-medium">{prev.name}</span>
        </a>
      ) : (
        <a href={href(`concepts/${p.id}/`)} class="group rounded-xl px-4 py-3 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
          <span class="flex items-center gap-1 font-mono text-[11px] tracking-wider text-muted-foreground uppercase"><ArrowLeftIcon className="size-3" />{p.code}</span>
          <span class="mt-0.5 block font-medium">{p.name}</span>
        </a>
      )}
      {next && (
        <a href={href(`concepts/${p.id}/${next.id}/`)} class="group rounded-xl px-4 py-3 text-right ring-1 ring-foreground/10 transition hover:ring-foreground/25">
          <span class="flex items-center justify-end gap-1 font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{p.name}<ArrowRightIcon className="size-3" /></span>
          <span class="mt-0.5 block font-medium">{next.name}</span>
        </a>
      )}
    </nav>

    <section class="mt-14 border-t pt-6 text-sm">
      <SectionLabel>Sources</SectionLabel>
      <SourceList sources={k.sources} />
    </section>

    {repo && (
      <p class="mt-8 text-sm text-muted-foreground">
        <a href={`${repo}/edit/main/content/concepts/${p.id}.json`} class="inline-flex items-center gap-1.5 underline-offset-4 hover:text-foreground hover:underline">
          <PencilIcon className="size-3.5" />Improve this page on GitHub
        </a>
      </p>
    )}
  </article>
</Base>
