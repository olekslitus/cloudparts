---
import { CodeIcon, ExternalLinkIcon, PencilIcon, ShapesIcon, TriangleAlertIcon } from 'lucide-react';
import Md from '@/components/Md.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import SourceList from '@/components/SourceList.astro';
import TechCard from '@/components/TechCard.astro';
import TechSection from '@/components/TechSection.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog, type CatalogBenchmark } from '@/lib/catalog';
import { href } from '@/lib/nav';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.benchmarks.map(b => ({ params: { id: b.id } }));
}

const c = await getCatalog();
const b = c.benchmarks.find(x => x.id === Astro.params.id) as CatalogBenchmark;
const techs = b.technologies.map(id => c.tech(id)).sort((x, y) => x.name.localeCompare(y.name));
const anchors = b.sections.map(s => s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''));
const repo = import.meta.env.PUBLIC_REPO_URL as string | undefined;
const pill = 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs';
---

<Base title={b.name} description={b.summary} section="benchmarks">
  <article>
    <header class="max-w-3xl">
      <Breadcrumbs items={[{ label: 'Benchmarks', path: 'benchmarks/' }, { label: c.category(c.concept(b.concepts[0]).category).name, path: `topics/${c.concept(b.concepts[0]).category}/` }]} />
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{b.name}</h1>
      <p class="mt-3 text-lg leading-relaxed text-pretty text-muted-foreground"><Md text={b.summary} /></p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        {b.concepts.map(id => (
          <a href={href(`concepts/${id}/`)} class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-medium text-brand transition hover:ring-1 hover:ring-brand/40">
            <ShapesIcon className="size-3" />{c.concept(id).name}
          </a>
        ))}
        <span class={pill}><span class="text-muted-foreground">Run by</span> {b.by}</span>
        {b.license && <span class={pill}><span class="text-muted-foreground">Licence</span> {b.license}</span>}
        <a href={b.website} class:list={[pill, 'transition hover:bg-muted']} rel="noopener">Results <ExternalLinkIcon className="size-3" /></a>
        {b.repo && <a href={b.repo} class:list={[pill, 'transition hover:bg-muted']} rel="noopener"><CodeIcon className="size-3" />Source code <ExternalLinkIcon className="size-3" /></a>}
      </div>
    </header>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
      <section>
        <SectionLabel>What it runs</SectionLabel>
        <div class="space-y-4 text-[17px] leading-relaxed">
          {b.intro.map(p => <p><Md text={p} /></p>)}
        </div>
      </section>
      <section>
        <SectionLabel>Setup</SectionLabel>
        <dl class="divide-y rounded-xl border">
          {b.setup.map(s => (
            <div class="grid gap-1 px-4 py-2.5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-3">
              <dt class="text-sm text-muted-foreground">{s.label}</dt>
              <dd class="text-sm leading-snug"><Md text={s.value} /></dd>
            </div>
          ))}
        </dl>
      </section>
    </div>

    <section class="mt-12 max-w-3xl">
      <SectionLabel>What the numbers don’t tell you</SectionLabel>
      <ul class="space-y-2.5">
        {b.caveats.map(x => (
          <li class="flex gap-2.5 leading-snug">
            <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-(--warn)/15 text-(--warn)"><TriangleAlertIcon className="size-3.5" /></span>
            <span><Md text={x} /></span>
          </li>
        ))}
      </ul>
    </section>

    {techs.length > 0 && (
      <section class="mt-12">
        <SectionLabel>Systems it covers that have a page here</SectionLabel>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {techs.map(t => <TechCard tech={t} />)}
        </div>
      </section>
    )}

    {b.sections.length > 0 && (
      <div class="mt-16 border-t pt-10">
        <SectionLabel>In depth</SectionLabel>
        <nav class="flex flex-wrap gap-2" aria-label="On this page">
          {b.sections.map((s, i) => (
            <a href={`#${anchors[i]}`} class="rounded-full border px-3 py-1 text-sm text-muted-foreground transition hover:border-foreground/30 hover:text-foreground">{s.title}</a>
          ))}
        </nav>
        {b.sections.map((s, i) => <TechSection section={s} anchor={anchors[i]} catalog={c} />)}
      </div>
    )}

    <section class="mt-14 border-t pt-6 text-sm">
      <SectionLabel>Sources · facts checked {b.checked}</SectionLabel>
      <SourceList sources={b.sources} />
      {repo && (
        <p class="mt-6 text-muted-foreground">
          <a href={`${repo}/edit/main/content/benchmarks/${b.id}.json`} class="inline-flex items-center gap-1.5 underline-offset-4 hover:text-foreground hover:underline">
            <PencilIcon className="size-3.5" />Improve this page on GitHub
          </a>
        </p>
      )}
    </section>
  </article>
</Base>
