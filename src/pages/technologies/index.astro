---
import TechCard from '@/components/TechCard.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog } from '@/lib/catalog';
import { href } from '@/lib/nav';

const c = await getCatalog();
const groups = c.categories
  .map(cat => ({
    cat,
    concepts: c.concepts
      .filter(p => p.category === cat.id)
      .map(p => ({ p, techs: c.technologies.filter(t => t.concepts[0] === p.id && !t.parent) }))
      .filter(g => g.techs.length),
  }))
  .filter(g => g.concepts.length);
---

<Base title="All technologies" description="Specific products, from Kafka to DuckLake, and how each fits with the others." section="technologies">
  <header class="max-w-3xl">
    <div class="mb-3 font-mono text-xs tracking-wider text-muted-foreground uppercase">{c.technologies.length} technologies</div>
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">All technologies</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted-foreground">
      Every product in the handbook on one page, grouped by the concept they implement. Distributions and managed services are counted under the project they come from, such as EKS under Kubernetes.
    </p>
    {c.foundations.map(f => (
      <a href={href(`foundations/${f.id}/`)} class="mt-4 inline-flex items-center gap-1.5 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
        {f.projects.length} are projects of {f.name}: what that means →
      </a>
    ))}
  </header>

  <nav class="mt-8 flex flex-wrap gap-2" aria-label="Categories">
    {groups.map(g => <a href={`#${g.cat.id}`} class="rounded-full border px-3 py-1 text-sm text-muted-foreground transition hover:border-foreground/30 hover:text-foreground">{g.cat.name}</a>)}
  </nav>

  {groups.map(g => (
    <section id={g.cat.id} class="mt-14 scroll-mt-20">
      <div class="flex items-baseline gap-2 border-b pb-2">
        <span class="font-mono text-[11px] font-semibold tracking-wider text-brand">{g.cat.code}</span>
        <h2 class="text-2xl font-semibold tracking-tight">{g.cat.name}</h2>
      </div>
      {g.concepts.map(({ p, techs }) => (
        <div class="mt-6 grid gap-3 lg:grid-cols-[200px_minmax(0,1fr)]">
          <a href={href(`concepts/${p.id}/`)} class="group self-start">
            <span class="block font-mono text-[10px] text-muted-foreground">{p.code}</span>
            <span class="font-medium group-hover:text-brand">{p.name}</span>
            <span class="mt-0.5 block text-xs leading-snug text-muted-foreground">{p.summary}</span>
          </a>
          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {techs.map(t => <TechCard tech={t} family={c.childrenOf(t.id)} note={t.kind ? c.kind(t.kind).name : undefined} />)}
          </div>
        </div>
      ))}
    </section>
  ))}
</Base>
