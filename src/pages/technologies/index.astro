---
import Glyph from '@/components/Glyph.astro';
import SortableTable from '@/components/SortableTable.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog } from '@/lib/catalog';
import { href, PROVIDER_TYPES, relationLabel, stageOf } from '@/lib/nav';

const c = await getCatalog();
const kindOf = (p: string) => (p === 'oss' ? 'oss' : p === 'vendor' ? 'vendor' : 'cloud');
const rows = c.technologies.map(t => {
  const cat = c.category(t.category);
  const concept = c.concept(t.concepts[0]);
  const context = t.parent ? relationLabel(t.parent.as, c.tech(t.parent.id).name) : t.kind ? c.kind(t.kind).name : undefined;
  return { t, cat, concept, context, part: cat.part, kind: kindOf(t.provider) };
});
const types = [
  { id: 'oss', label: 'Open source' },
  { id: 'cloud', label: 'Cloud services' },
  { id: 'vendor', label: 'Commercial' },
];
const chip = 'rounded-full border px-3 py-1 text-sm text-muted-foreground transition hover:border-foreground/30 hover:text-foreground aria-pressed:border-brand/40 aria-pressed:bg-brand-soft aria-pressed:font-medium aria-pressed:text-foreground';
const th = 'px-3 py-2.5 text-left align-bottom font-mono text-[11px] font-medium tracking-wide text-muted-foreground uppercase';
const sortBtn = 'inline-flex items-center gap-1 uppercase hover:text-foreground';
---

<Base title="Technologies" description="Every product in the handbook, from Kafka to DuckLake, in one table you can search, filter and sort." section="technologies">
  <header class="max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Technologies</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted-foreground">
      All {c.technologies.length} products in the handbook in one table. Type to filter, pick an area or a type, or click a column to sort.
      Each one links to its page, and to the concept it’s an example of.
    </p>
    {c.foundations.map(f => (
      <a href={href(f.path)} class="mt-3 flex w-fit items-center gap-1.5 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
        {f.type === 'company'
          ? <>{f.projects.length} are made by {f.name}: how they fit together →</>
          : <>{f.projects.length} are projects of {f.name}: what that means →</>}
      </a>
    ))}
  </header>

  <div class="mt-8 grid gap-3" data-filters>
    <input
      type="search"
      data-q
      placeholder="Filter by name, concept or description, e.g. iceberg, rust, queue"
      aria-label="Filter technologies"
      class="h-10 w-full max-w-xl rounded-lg border bg-background px-3 text-[15px] outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-brand/40"
    />
    <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Area">
      <span class="mr-1 text-sm text-muted-foreground">Area:</span>
      <button type="button" class={chip} data-part="" aria-pressed="true">All</button>
      {c.parts.map(p => <button type="button" class={chip} data-part={p.id} aria-pressed="false">{p.name}</button>)}
    </div>
    <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Type">
      <span class="mr-1 text-sm text-muted-foreground">Type:</span>
      <button type="button" class={chip} data-type="" aria-pressed="true">All</button>
      {types.map(x => <button type="button" class={chip} data-type={x.id} aria-pressed="false">{x.label}</button>)}
    </div>
    <p class="text-sm text-muted-foreground" aria-live="polite"><span data-count>{rows.length}</span> of {rows.length} technologies</p>
  </div>

  <div class="mt-4 overflow-x-auto rounded-xl bg-card ring-1 ring-foreground/10">
    <table class="w-full border-collapse text-sm" data-sortable>
      <thead>
        <tr class="border-b bg-muted/50">
          {['Technology', 'Concept', 'Type', 'License', 'Checked'].map((col, i) => (
            <th scope="col" class={th} aria-sort="none">
              <button type="button" class={sortBtn} data-sort={i}>{col}<span aria-hidden="true" data-arrow></span></button>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map(({ t, concept, context, part, kind }) => (
          <tr
            class="border-b align-top last:border-b-0"
            data-part={part}
            data-type={kind}
            data-text={[t.name, t.id, t.summary, concept.name, context ?? '', t.vendor ?? '', t.license ?? ''].join(' ').toLowerCase()}
          >
            <td class="min-w-60 px-3 py-2.5" data-v={t.name.toLowerCase()}>
              <a href={href(`technologies/${t.id}/`)} class="inline-flex items-center gap-2 font-medium underline-offset-4 hover:text-brand hover:underline"><Glyph tech={t} />{t.name}</a>
              {stageOf(t) && <span class="ml-1.5 align-middle"><StatusBadge tech={t} /></span>}
              <span class="mt-0.5 block text-xs leading-snug text-muted-foreground">{t.summary}</span>
            </td>
            <td class="min-w-40 px-3 py-2.5" data-v={concept.name}>
              <a href={href(`concepts/${concept.id}/`)} class="underline-offset-4 hover:text-brand hover:underline">{concept.name}</a>
              {context && <span class="block text-xs text-muted-foreground">{context}</span>}
            </td>
            <td class="min-w-28 px-3 py-2.5" data-v={PROVIDER_TYPES[t.provider]}>{PROVIDER_TYPES[t.provider]}</td>
            <td class="min-w-36 px-3 py-2.5" data-v={t.license ?? ''}><span class="line-clamp-3" title={t.license}>{t.license ?? '–'}</span></td>
            <td class="px-3 py-2.5 font-mono text-xs whitespace-nowrap text-muted-foreground" data-v={t.checked}>{t.checked}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p data-empty hidden class="mt-6 text-muted-foreground">Nothing matches. Try fewer words, or set the area and type back to All.</p>
</Base>

<SortableTable />

<script>
  // Filters the table by text, area and type, and keeps the filters in the URL so a filtered view can be shared.
  const box = document.querySelector<HTMLElement>('[data-filters]')!;
  const input = box.querySelector<HTMLInputElement>('[data-q]')!;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('tbody tr[data-text]')];
  const count = box.querySelector('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const state = { q: '', part: '', type: '' };

  const press = (attr: 'part' | 'type') => {
    for (const b of box.querySelectorAll<HTMLButtonElement>(`button[data-${attr}]`)) {
      b.setAttribute('aria-pressed', String(b.dataset[attr] === state[attr]));
    }
  };
  const apply = () => {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    let n = 0;
    for (const r of rows) {
      const show = (!state.part || r.dataset.part === state.part)
        && (!state.type || r.dataset.type === state.type)
        && words.every(w => r.dataset.text!.includes(w));
      r.hidden = !show;
      if (show) n++;
    }
    count.textContent = String(n);
    empty.hidden = n > 0;
    press('part');
    press('type');
    const url = new URL(location.href);
    for (const k of ['q', 'part', 'type'] as const) {
      if (state[k]) url.searchParams.set(k, state[k]); else url.searchParams.delete(k);
    }
    history.replaceState(null, '', url);
  };

  const params = new URLSearchParams(location.search);
  state.q = params.get('q') ?? '';
  state.part = params.get('part') ?? '';
  state.type = params.get('type') ?? '';
  input.value = state.q;
  input.addEventListener('input', () => { state.q = input.value; apply(); });
  for (const attr of ['part', 'type'] as const) {
    for (const b of box.querySelectorAll<HTMLButtonElement>(`button[data-${attr}]`)) {
      b.addEventListener('click', () => { state[attr] = b.dataset[attr]!; apply(); });
    }
  }
  apply();
</script>
