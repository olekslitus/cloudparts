---
import Base from '@/layouts/Base.astro';
import { href } from '@/lib/nav';
---
<Base title="Not found">
  <div class="py-20 text-center">
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">This part isn’t in the catalog</h1>
    <p class="mt-3 text-muted-foreground">Try the search, or go back to the <a href={href()} class="underline underline-offset-4">system map</a>.</p>
  </div>
</Base>
