---
import ArchCard from '@/components/ArchCard.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog } from '@/lib/catalog';
import { href } from '@/lib/nav';

const c = await getCatalog();
---

<Base title="Architectures" description="Real stacks built from real technologies, each with a live model you can open in the playground." section="architectures">
  <header class="max-w-3xl">
    <div class="mb-3 font-mono text-xs tracking-wider text-muted-foreground uppercase">{c.architectures.length} architectures</div>
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Architectures</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted-foreground">
      Technologies make the most sense next to the things they connect to. Each of these is a common, real-world stack:
      watch it run, follow the data step by step, and see where it strains.
    </p>
  </header>
  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {c.architectures.map(a => <ArchCard arch={a} catalog={c} />)}
    <a href={href('playground/')} class="flex flex-col justify-center rounded-xl border border-dashed p-4 text-muted-foreground transition hover:border-foreground/30 hover:text-foreground">
      <span class="font-semibold text-foreground">Design your own</span>
      <span class="mt-1 text-sm">Drag technologies onto a canvas, connect them, and run traffic through your design.</span>
    </a>
  </div>
</Base>
