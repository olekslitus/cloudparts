---
import { CheckIcon, PencilIcon, RepeatIcon, TriangleAlertIcon } from 'lucide-react';
import ArchCard from '@/components/ArchCard.astro';
import LiveModel from '@/components/LiveModel';
import Md from '@/components/Md.astro';
import ResourceList from '@/components/ResourceList.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import SourceList from '@/components/SourceList.astro';
import TechCard from '@/components/TechCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog, type CatalogArch } from '@/lib/catalog';
import { diagramLinks } from '@/lib/links';
import { href, REPO_URL } from '@/lib/nav';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.architectures.map(a => ({ params: { id: a.id } }));
}

const c = await getCatalog();
const a = c.architectures.find(x => x.id === Astro.params.id) as CatalogArch;
const nodes = new Map(a.diagram.nodes.map(n => [n.id, n]));
// generic boxes (a concept but no specific product), e.g. "Load balancer"
const generic = [...new Set(a.diagram.nodes.filter(n => !n.tech && n.concept).map(n => n.concept!))];
const others = c.architectures
  .filter(x => x.id !== a.id)
  .map(x => ({ x, shared: x.techs.filter(t => a.techs.includes(t)).length }))
  .filter(o => o.shared > 0)
  .sort((p, q) => q.shared - p.shared)
  .slice(0, 4)
  .map(o => o.x);
const resources = c.resourcesAbout('architectures', a.id);
const repo = REPO_URL;
const chip = 'inline-flex items-center rounded-md border bg-background px-2 py-0.5 text-xs font-medium transition hover:border-foreground/30 hover:bg-muted';
---

<Base title={a.title} description={a.summary} active={a.id} section="architectures">
  <article>
    <header class="max-w-3xl">
      <Breadcrumbs items={[{ label: 'Architectures', path: 'architectures/' }]} />
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{a.title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-pretty text-muted-foreground"><Md text={a.summary} /></p>
      <div class="mt-4 flex flex-wrap gap-2 text-xs">
        <span class="rounded-full bg-brand-soft px-2.5 py-0.5 font-medium text-brand">Fits: {a.fits}</span>
        <span class="rounded-full border px-2.5 py-0.5 text-muted-foreground">{a.techs.length} technologies</span>
      </div>
    </header>

    <div class="mt-8">
      <LiveModel client:visible diagram={a.diagram} links={diagramLinks(c, a.diagram)} warmup={7000}>
        <a href={href(`playground/?a=${a.id}`)} class="hidden h-7 items-center rounded-md border px-2.5 text-[13px] font-medium transition hover:bg-muted sm:inline-flex">Open in playground</a>
      </LiveModel>
      <p class="mt-2 text-sm text-muted-foreground">Click any box to open its page. <a href={href(`playground/?a=${a.id}`)} class="underline underline-offset-4 hover:text-foreground">Open it in the playground</a> to rewire it, change the traffic or take parts down.</p>
    </div>

    <p class="mt-10 max-w-3xl text-[17px] leading-relaxed"><Md text={a.intro} /></p>

    <section class="mt-12">
      <SectionLabel>How it flows</SectionLabel>
      <ol class="relative space-y-6 border-l pl-8">
        {a.steps.map((s, i) => (
          <li class="relative">
            <span class="absolute top-0 -left-[45px] inline-flex size-7 items-center justify-center rounded-full border bg-background font-mono text-xs font-semibold">{i + 1}</span>
            <h3 class="font-semibold">{s.title}</h3>
            <p class="mt-1 max-w-3xl leading-relaxed text-foreground/90"><Md text={s.text} /></p>
            {s.nodes.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-1.5">
                {s.nodes.map(id => {
                  const n = nodes.get(id)!;
                  return n.tech
                    ? <a href={href(`technologies/${n.tech}/`)} class={chip}>{c.tech(n.tech).name}</a>
                    : n.concept
                      ? <a href={href(`concepts/${n.concept}/`)} class={chip}>{n.label}</a>
                      : <span class="inline-flex items-center rounded-md bg-muted px-2 py-0.5 text-xs">{n.label}</span>;
                })}
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <section>
        <SectionLabel>Why this shape works</SectionLabel>
        <ul class="space-y-2.5">
          {a.good.map(u => (
            <li class="flex gap-2.5 leading-snug">
              <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-(--ok)/15 text-(--ok)"><CheckIcon className="size-3.5" /></span>
              <span><Md text={u} /></span>
            </li>
          ))}
        </ul>
      </section>
      <section>
        <SectionLabel>Where it strains</SectionLabel>
        <ul class="space-y-2.5">
          {a.watch.map(u => (
            <li class="flex gap-2.5 leading-snug">
              <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-(--warn)/15 text-(--warn)"><TriangleAlertIcon className="size-3" /></span>
              <span><Md text={u} /></span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    {a.swaps.length > 0 && (
      <section class="mt-12">
        <SectionLabel>Common swaps</SectionLabel>
        <ul class="grid gap-3 md:grid-cols-2">
          {a.swaps.map(s => (
            <li class="flex gap-3 rounded-xl bg-card p-4 ring-1 ring-foreground/10">
              <RepeatIcon className="mt-0.5 size-4 shrink-0 text-muted-foreground" />
              <div>
                <p class="leading-snug"><Md text={s.text} /></p>
                {s.techs.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {s.techs.map(id => <a href={href(`technologies/${id}/`)} class={chip}>{c.tech(id).name}</a>)}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-12">
      <SectionLabel>Built from</SectionLabel>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {a.techs.map(id => {
          const t = c.tech(id);
          return <TechCard tech={t} note={c.concept(t.concepts[0]).name} />;
        })}
        {generic.map(id => {
          const p = c.concept(id);
          return (
            <a href={href(`concepts/${id}/`)} class="group flex flex-col rounded-xl border border-dashed p-4 transition hover:border-foreground/30">
              <span class="font-medium group-hover:text-brand">{p.name}</span>
              <span class="mt-1 text-xs font-medium text-muted-foreground">Any product will do</span>
              <span class="mt-1 line-clamp-2 text-sm leading-snug text-muted-foreground">{p.summary}</span>
            </a>
          );
        })}
      </div>
    </section>

    {others.length > 0 && (
      <section class="mt-12">
        <SectionLabel>Architectures with parts in common</SectionLabel>
        <div class="grid gap-3 sm:grid-cols-2">
          {others.map(x => <ArchCard arch={x} catalog={c} />)}
        </div>
      </section>
    )}

    {resources.length > 0 && (
      <section class="mt-12">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <SectionLabel class="mb-0">Worth exploring</SectionLabel>
          <a href={href('resources/')} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">All resources →</a>
        </div>
        <ResourceList resources={resources} />
      </section>
    )}

    {a.sources && (
      <section class="mt-14 border-t pt-6 text-sm">
        <SectionLabel>Sources</SectionLabel>
        <SourceList sources={a.sources} />
      </section>
    )}

    {repo && (
      <p class="mt-10 text-sm text-muted-foreground">
        <a href={`${repo}/edit/main/content/architectures/${a.id}.json`} class="inline-flex items-center gap-1.5 underline-offset-4 hover:text-foreground hover:underline">
          <PencilIcon className="size-3.5" />Improve this page on GitHub
        </a>
      </p>
    )}
  </article>
</Base>
