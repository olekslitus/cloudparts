---
import { ArrowLeftRightIcon, ArrowRightIcon, NetworkIcon, ShapesIcon, SquareMousePointerIcon } from 'lucide-react';
import ArchCard from '@/components/ArchCard.astro';
import LiveModel from '@/components/LiveModel';
import Base from '@/layouts/Base.astro';
import { getCatalog } from '@/lib/catalog';
import { diagramLinks } from '@/lib/links';
import { href } from '@/lib/nav';

const c = await getCatalog();
const layers = [
  { icon: ShapesIcon, path: 'concepts/', title: 'Handbook', count: `${c.concepts.length + c.technologies.length}`, text: 'Start with the idea, such as a queue or an event loop, then go deeper to the products that implement it, like Kafka or PostgreSQL.' },
  { icon: NetworkIcon, path: 'architectures/', title: 'Architectures', count: `${c.architectures.length}`, text: 'Real stacks built from those products, running live, explained step by step.' },
  { icon: ArrowLeftRightIcon, path: 'compare/', title: 'Compare', count: `${c.comparisons.length}`, text: 'Ideas and products that are easy to mix up, side by side, with a rule of thumb for picking one.' },
  { icon: SquareMousePointerIcon, path: 'playground/', title: 'Playground', count: 'new', text: 'Drag technologies onto a canvas, connect them and run traffic through your own design.' },
];
---

<Base section="home">
  <section class="max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">How modern software is written, shipped and kept running</h1>
    <p class="mt-4 text-lg leading-relaxed text-pretty text-muted-foreground">
      Cloud Parts is a handbook for modern software engineering, from the code itself to the cloud it runs on and the
      teams that build it. Start with the idea, meet the products, then watch them work together in real architectures.
    </p>
  </section>

  <ol class="mt-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    {layers.map((l, i) => (
      <li>
        <a href={href(l.path)} class="group flex h-full flex-col rounded-xl bg-card p-4 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
          <span class="flex items-center justify-between">
            <span class="inline-flex size-8 items-center justify-center rounded-lg bg-brand-soft text-brand"><l.icon className="size-4" /></span>
            <span class="font-mono text-[11px] text-muted-foreground">{i + 1} · {l.count}</span>
          </span>
          <span class="mt-3 flex items-center gap-1 font-semibold group-hover:text-brand">{l.title}<ArrowRightIcon className="size-3.5 opacity-0 transition group-hover:translate-x-0.5 group-hover:opacity-100" /></span>
          <span class="mt-1 text-sm leading-snug text-muted-foreground">{l.text}</span>
        </a>
      </li>
    ))}
  </ol>

  <section class="mt-14" aria-labelledby="map">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
      <h2 id="map" class="text-2xl font-semibold tracking-tight">The whole system, at concept level</h2>
      <p class="text-sm text-muted-foreground">Click any box to learn the concept.</p>
    </div>
    <LiveModel client:visible diagram={c.systemMap} links={diagramLinks(c, c.systemMap)} warmup={7000} />
  </section>

  {c.architectures.length > 0 && (
    <section class="mt-16" aria-labelledby="stacks">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
        <h2 id="stacks" class="text-2xl font-semibold tracking-tight">Real stacks</h2>
        <a href={href('architectures/')} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">All {c.architectures.length} architectures →</a>
      </div>
      <div class="grid gap-3 md:grid-cols-2">
        {c.architectures.slice(0, 4).map(a => <ArchCard arch={a} catalog={c} />)}
      </div>
    </section>
  )}

  <section class="mt-16" aria-labelledby="handbook">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
      <h2 id="handbook" class="text-2xl font-semibold tracking-tight">The handbook, in {c.parts.length} parts</h2>
      <a href={href('concepts/')} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">All {c.concepts.length} concepts →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
      {c.parts.map((part, n) => (
        <section class="flex flex-col rounded-xl bg-card ring-1 ring-foreground/10">
          <a href={href(`concepts/#${part.id}`)} class="group block border-b px-4 py-3">
            <span class="block font-mono text-[11px] tracking-wider text-muted-foreground uppercase">Part {n + 1}</span>
            <h3 class="font-semibold group-hover:text-brand">{part.name}</h3>
            <span class="mt-0.5 block text-sm leading-snug text-muted-foreground">{part.blurb}</span>
          </a>
          <ul class="divide-y">
            {part.categories.map(cat => (
              <li>
                <a href={href(`topics/${cat.id}/`)} class="group flex items-baseline gap-2 px-4 py-2.5 transition-colors hover:bg-muted/60">
                  <span class="w-9 shrink-0 font-mono text-[11px] font-semibold tracking-wider text-brand">{cat.code}</span>
                  <span class="min-w-0 flex-1 text-sm font-medium group-hover:text-brand">{cat.name}</span>
                  <span class="shrink-0 font-mono text-[10px] text-muted-foreground">{c.concepts.filter(p => p.category === cat.id).length}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="mt-16" aria-labelledby="confused">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
      <h2 id="confused" class="text-2xl font-semibold tracking-tight">Commonly confused</h2>
      <a href={href('compare/')} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">All {c.comparisons.length} comparisons →</a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {c.comparisons.slice(0, 6).map(m => (
        <a href={href(`compare/${m.id}/`)} class="group flex items-center justify-between gap-3 rounded-xl bg-card px-4 py-3.5 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
          <span>
            <span class="block font-medium">{m.title}</span>
            <span class="font-mono text-[11px] text-muted-foreground">{m.concepts.length ? m.columns.map(col => col.code).join(' · ') : m.columns.map(col => col.name).join(' · ')}</span>
          </span>
          <ArrowRightIcon className="size-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-foreground" />
        </a>
      ))}
    </div>
  </section>

  <script is:inline define:vars={{ concepts: c.concepts.map(p => p.id), base: href() }}>
    // Keep old deep links from the single-file version working (#queue, #vs-messaging, #mixups).
    const h = decodeURIComponent(location.hash.slice(1));
    if (concepts.includes(h)) location.replace(`${base}concepts/${h}/`);
    else if (h === 'mixups') location.replace(`${base}compare/`);
    else if (h.startsWith('vs-')) location.replace(`${base}compare/${h.slice(3)}/`);
  </script>
</Base>
