---
import Glyph from '@/components/Glyph.astro';
import { ArrowLeftRightIcon, ArrowRightIcon } from 'lucide-react';
import ArchCard from '@/components/ArchCard.astro';
import BenchmarkList from '@/components/BenchmarkList.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ResourceList from '@/components/ResourceList.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import Base from '@/layouts/Base.astro';
import { getCatalog } from '@/lib/catalog';
import { href, PROVIDER_SHORT, STAGE_LABELS, STAGE_WARN, stageOf } from '@/lib/nav';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.categories.map(cat => ({ params: { id: cat.id } }));
}

const c = await getCatalog();
const t = c.topic(Astro.params.id);
const { category: cat, part } = t;
const counts = [
  [t.concepts.length, 'concept'],
  [t.technologies.length, 'technology'],
  [t.comparisons.length, 'comparison'],
  [t.architectures.length, 'real stack'],
] as const;
const plural = (n: number, word: string) => `${n} ${n === 1 ? word : word === 'technology' ? 'technologies' : `${word}s`}`;
---

<Base title={cat.name} description={`${cat.blurb} Concepts, technologies, comparisons and real stacks about ${cat.name.toLowerCase()}.`} active={cat.id} section="topics">
  <header class="max-w-3xl">
    <Breadcrumbs items={[{ label: 'Concepts', path: 'concepts/' }, { label: part.name, path: `concepts/#${part.id}` }]} />
    <Glyph icon={cat.icon} class="mb-4 block size-11" />
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{cat.name}</h1>
    <p class="mt-3 text-lg leading-relaxed text-pretty text-muted-foreground">{cat.blurb}</p>
    <p class="mt-3 font-mono text-xs tracking-wider text-muted-foreground uppercase">{counts.filter(([n]) => n > 0).map(([n, w]) => plural(n, w)).join(' · ')}</p>
  </header>


  <section class="mt-10" aria-labelledby="concepts">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
      <SectionLabel class="mb-0"><span id="concepts">Concepts</span></SectionLabel>
      <a href={href(`concepts/${t.concepts[0].id}/`)} class="inline-flex items-center gap-1 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Start with {t.concepts[0].name}<ArrowRightIcon className="size-3.5" /></a>
    </div>
    <ol class="divide-y overflow-hidden rounded-xl bg-card ring-1 ring-foreground/10">
      {t.concepts.map(p => {
        const n = c.techsFor(p.id).length + c.usedFor(p.id).length;
        return (
          <li>
            <a href={href(`concepts/${p.id}/`)} class="group flex gap-3 px-4 py-3.5 transition-colors hover:bg-muted/60">
              <Glyph icon={p.icon} class="mt-0.5 size-5" />
              <span class="min-w-0 flex-1">
                <span class="flex items-baseline justify-between gap-2">
                  <span class="font-medium group-hover:text-brand">{p.name}</span>
                  {n > 0 && <span class="shrink-0 font-mono text-[10px] text-muted-foreground">{plural(n, 'technology')}</span>}
                </span>
                <span class="mt-0.5 block text-sm leading-snug text-muted-foreground">{p.summary}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  {t.technologies.length > 0 && (
    <section class="mt-12" aria-labelledby="technologies">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
        <SectionLabel class="mb-0"><span id="technologies">Technologies</span></SectionLabel>
        <span class="text-sm text-muted-foreground">Grouped by the concept each one mainly implements</span>
      </div>
      <div class="grid gap-5">
        {t.concepts.map(p => ({ p, techs: [...t.technologies.filter(x => x.concepts[0] === p.id && !x.parent), ...c.usedFor(p.id)] })).filter(g => g.techs.length).map(({ p, techs }) => (
          <div>
            <a href={href(`concepts/${p.id}/`)} class="inline-flex items-center gap-1.5 text-sm font-medium hover:text-brand"><Glyph icon={p.icon} class="size-4" />{p.name}</a>
            <ul class="mt-1.5 flex flex-wrap gap-1.5">
              {techs.map(x => (
                <li>
                  <a href={href(`technologies/${x.id}/`)} title={x.summary} class="inline-flex items-center gap-1.5 rounded-md border bg-background px-2 py-0.5 text-sm transition hover:border-foreground/30 hover:bg-muted">
                    <Glyph tech={x} class="size-3.5" />
                    <span class:list={[x.archived && 'text-muted-foreground line-through decoration-muted-foreground/50']}>{x.name}</span>
                    <span class:list={['font-mono text-[9px] uppercase', stageOf(x) ? (STAGE_WARN.has(stageOf(x)!) ? 'text-(--warn)' : 'text-brand') : 'text-muted-foreground']}>{stageOf(x) ? STAGE_LABELS[stageOf(x)!] : PROVIDER_SHORT[x.provider]}</span>
                    {c.childrenOf(x.id).length > 0 && <span class="font-mono text-[9px] text-brand">+{c.childrenOf(x.id).length}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {t.comparisons.length > 0 && (
    <section class="mt-12" aria-labelledby="compare">
      <SectionLabel><span id="compare">Commonly confused</span></SectionLabel>
      <div class="grid gap-2">
        {t.comparisons.map(m => (
          <a href={href(`compare/${m.id}/`)} class="group flex min-w-0 items-center justify-between gap-3 rounded-xl bg-card px-4 py-3.5 ring-1 ring-foreground/10 transition hover:ring-foreground/25">
            <span class="min-w-0">
              <span class="flex items-center gap-2 font-medium"><ArrowLeftRightIcon className="size-3.5 shrink-0 text-muted-foreground" />{m.title}</span>
              <span class="mt-0.5 block truncate text-xs text-muted-foreground">{m.columns.map(col => col.name).join(' · ')}</span>
            </span>
            <ArrowRightIcon className="size-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-foreground" />
          </a>
        ))}
      </div>
    </section>
  )}

  {t.architectures.length > 0 && (
    <section class="mt-12" aria-labelledby="stacks">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
        <SectionLabel class="mb-0"><span id="stacks">See it in a real stack</span></SectionLabel>
        <span class="text-sm text-muted-foreground">Architectures that use {cat.name.toLowerCase()} concepts</span>
      </div>
      <div class="grid gap-2">
        {t.architectures.map(a => <ArchCard arch={a} catalog={c} />)}
      </div>
    </section>
  )}

  {t.resources.length > 0 && (
    <section class="mt-12">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
        <SectionLabel class="mb-0">Worth exploring</SectionLabel>
        <a href={href('resources/')} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">All resources →</a>
      </div>
      <ResourceList resources={t.resources} />
    </section>
  )}

  {t.benchmarks.length > 0 && (
    <section class="mt-12">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
        <SectionLabel class="mb-0">Benchmarks</SectionLabel>
        <a href={href('benchmarks/')} class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">How to read a benchmark →</a>
      </div>
      <BenchmarkList benchmarks={t.benchmarks} catalog={c} />
    </section>
  )}

</Base>
